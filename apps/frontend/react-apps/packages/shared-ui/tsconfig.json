{
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "target": "ES2019",
        "module": "ESNext",
        "declaration": true,
        "declarationMap": true,
        "jsx": "react",
        "strict": true,
        // If you're using react 17 or 18
        "esModuleInterop": true,
        "skipLibCheck": false,
        "moduleResolution": "node"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}