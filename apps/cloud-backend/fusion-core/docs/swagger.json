                        "type": "string",
                        "description": "Project ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Sync request containing metadata and ZIP file URL",
                        "name": "syncRequest",
                        "in": "body",
                        "required": true,
