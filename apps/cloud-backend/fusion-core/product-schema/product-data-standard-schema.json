{
  "version" : "1.0.2",
  "date" : "18-03-2026",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boseprofessional.com/schemas/project-data-schema",
  "title": "Bose Professional Product Data Schema",
  "description": "JSON Schema for Bose Professional audio products including speakers, amplifiers, DSPs, controllers, and I/O endpoints",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Data schema version",
      "pattern": "^\\d+\\.\\d+$",
      "examples": [
        "1.0",
        "1.1",
        "2.0"
      ]
    },
    "title": {
      "type": "string",
      "description": "Data schema title"
    },
    "description": {
      "type": "string",
      "description": "Data schema description"
    },
    "speakers": {
      "type": "array",
      "description": "Array of speaker products",
      "items": {
        "$ref": "#/$defs/speaker"
      }
    },
    "amplifiers": {
      "type": "array",
      "description": "Array of amplifier products",
      "items": {
        "$ref": "#/$defs/amplifier"
      }
    },
    "digital_signal_processors": {
      "type": "array",
      "description": "Array of digital signal processor products",
      "items": {
        "$ref": "#/$defs/digitalSignalProcessor"
      }
    },
    "controllers": {
      "type": "array",
      "description": "Array of controller products",
      "items": {
        "$ref": "#/$defs/controller"
      }
    },
    "i_o_endpoints": {
      "type": "array",
      "description": "Array of I/O endpoint products",
      "items": {
        "$ref": "#/$defs/ioEndpoint"
      }
    },
    "additional_accessories": {
      "type": "array",
      "description": "Array of additional accessories",
      "items": {
        "$ref": "#/$defs/accessory"
      }
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "$defs": {
    "speaker": {
      "type": "object",
      "title": "Speaker Product",
      "description": "Bose Professional speaker product specification",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique product identifier",
          "minimum": 1
        },
        "model_family": {
          "type": "string",
          "description": "Product model family name",
          "minLength": 1,
          "enum": [
            "DesignMax",
            "FreeSpace",
            "Edgemax",
            "AMU",
            "MA",
            "MB",
            "AMM",
            "Forum",
            "ArenaMatch"
          ]
        },
        "type": {
          "type": "string",
          "description": "Speaker product line/type"
        },
        "model_name": {
          "type": "string",
          "description": "Full product name",
          "minLength": 1
        },
        "data_sheet_link": {
          "type": "string",
          "format": "uri",
          "description": "URL to product data sheet"
        },
        "bsf_file_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to BSF (Bose Speaker File) configuration"
        },
        "dsp_eq_file_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to DSP EQ file"
        },
        "skus": {
          "type": "array",
          "description": "Array of SKU numbers",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "power_handling": {
          "$ref": "#/$defs/powerHandling"
        },
        "sensitivity": {
          "$ref": "#/$defs/measurement"
        },
        "max_spl": {
          "$ref": "#/$defs/measurement"
        },
        "frequency_range": {
          "$ref": "#/$defs/frequencyRange"
        },
        "frequency_response": {
          "$ref": "#/$defs/frequencyResponse"
        },
        "frequency_response_curve": {
          "type": "array",
          "description": "Frequency response curve data points",
          "items": {
            "$ref": "#/$defs/frequencyResponsePoint"
          }
        },
        "nominal_impedance": {
          "$ref": "#/$defs/valueWithUnit"
        },
        "coverage": {
          "type": "array",
          "description": "Speaker coverage patterns",
          "items": {
            "$ref": "#/$defs/coverage"
          }
        },
        "acoustic_technology": {
          "type": "string",
          "description": "Acoustic technology description"
        },
        "installation": {
          "$ref": "#/$defs/installation"
        },
        "certifications": {
          "type": "array",
          "description": "Product certifications",
          "items": {
            "type": "string"
          }
        },
        "product_codes": {
          "type": "array",
          "description": "Product ordering codes",
          "items": {
            "type": "string"
          }
        },
        "short_description": {
          "type": "string",
          "description": "Brief product description"
        },
        "description": {
          "type": "string",
          "description": "Detailed product description"
        },
        "environment": {
          "type": "string",
          "enum": [
            "Indoor",
            "Outdoor",
            "Indoor/Outdoor"
          ],
          "description": "Environmental rating"
        },
        "dimensions": {
          "type": "array",
          "description": "Product dimensions in different units",
          "items": {
            "$ref": "#/$defs/dimensions"
          }
        },
        "mount_type": {
          "type": "string",
          "description": "Mounting type",
          "enum": [
            "Rack",
            "Wall",
            "Ceiling",
            "Pendant",
            "Surface",
            "Flush"
          ]
        },
        "impedance": {
          "$ref": "#/$defs/impedanceRange"
        },
        "impedance_curve": {
          "type": "array",
          "description": "Impedance curve data points",
          "items": {
            "$ref": "#/$defs/impedancePoint"
          }
        },
        "voltage_taps": {
          "$ref": "#/$defs/voltageTaps"
        },
        "no_of_passbands": {
          "type": "integer",
          "description": "Number of passbands",
          "minimum": 1
        },
        "images": {
          "type": "array",
          "description": "Product images by color",
          "items": {
            "$ref": "#/$defs/productImages"
          }
        },
        "is_subwoofer": {
          "type": "boolean",
          "description": "Whether the speaker is a subwoofer"
        },
        "is_weather_rated": {
          "type": "boolean",
          "description": "Whether the speaker is weather rated"
        },
        "is_high_impedance_rated": {
          "type": "boolean",
          "description": "Whether the speaker supports high impedance"
        },
        "polar_data": {
          "type": "string",
          "format": "uri",
          "description": "URL to polar response data"
        },
        "bose_professional_voicing": {
          "type": "string",
          "format": "uri",
          "description": "URL to Bose Professional voicing data"
        },
        "driver_components": {
          "$ref": "#/$defs/driverComponents"
        },
        "net_weight": {
          "type": "array",
          "description": "Product weight in different units",
          "items": {
            "$ref": "#/$defs/valueWithUnit"
          }
        },
        "updated_at": {
          "type": "string",
          "format": "epoch",
          "description": "Timestamp of when this speaker was last updated"
        }
      },
      "required": [
        "id",
        "model_family",
        "model_name",
        "skus",
        "bsf_file_url",
        "power_handling",
        "sensitivity",
        "max_spl",
        "frequency_range",
        "nominal_impedance",
        "coverage",
        "description",
        "environment",
        "mount_type",
        "impedance",
        "voltage_taps",
        "images",
        "is_subwoofer",
        "is_weather_rated",
        "is_high_impedance_rated"
      ],
      "additionalProperties": false
    },
    "amplifier": {
      "type": "object",
      "title": "Amplifier Product",
      "description": "Bose Professional amplifier product specification",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique product identifier",
          "minimum": 1
        },
        "model_family": {
          "type": "string",
          "description": "Product model family",
          "minLength": 1
        },
        "model_name": {
          "type": "string",
          "description": "Full product name",
          "minLength": 1
        },
        "data_sheet_link": {
          "type": "string",
          "format": "uri",
          "description": "URL to product data sheet"
        },
        "skus": {
          "type": "array",
          "description": "Array of SKU numbers",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "power_output": {
          "$ref": "#/$defs/amplifierPowerOutput"
        },
        "number_of_inputs_and_outputs": {
          "$ref": "#/$defs/inputsOutputs"
        },
        "front_panel_image": {
          "type": "string",
          "description": "Path to front panel image"
        },
        "rear_panel_image": {
          "type": "string",
          "description": "Path to rear panel image"
        },
        "thermal_output": {
          "$ref": "#/$defs/valueWithUnit"
        },
        "current_draw": {
          "$ref": "#/$defs/measurement"
        },
        "rack_height": {
          "$ref": "#/$defs/valueWithUnit"
        },
        "safe_operating_temperature": {
          "$ref": "#/$defs/temperatureRange"
        },
        "firmware": {
          "$ref": "#/$defs/firmware"
        },
        "images": {
          "type": "array",
          "description": "Product images",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "colors": {
          "type": "array",
          "description": "Available colors",
          "items": {
            "type": "string"
          }
        },
        "dimensions": {
          "type": "array",
          "description": "Product dimensions in different units",
          "items": {
            "$ref": "#/$defs/dimensions"
          }
        },
        "net_weight": {
          "type": "array",
          "description": "Product weight in different units",
          "items": {
            "$ref": "#/$defs/valueWithUnit"
          }
        },
        "certifications": {
          "type": "array",
          "description": "Product certifications",
          "items": {
            "type": "string"
          }
        },
        "product_codes": {
          "type": "array",
          "description": "Product ordering codes",
          "items": {
            "type": "string"
          }
        },
        "updated_at": {
          "type": "string",
          "format": "epoch",
          "description": "Timestamp of when this amplifier was last updated"
        }
      },
      "required": [
        "id",
        "model_family",
        "model_name",
        "skus",
        "power_output",
        "number_of_inputs_and_outputs",
        "front_panel_image",
        "rear_panel_image"
      ],
      "additionalProperties": false
    },
    "digitalSignalProcessor": {
      "type": "object",
      "title": "Digital Signal Processor Product",
      "description": "Bose Professional DSP product specification",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique product identifier",
          "minimum": 1
        },
        "model_family": {
          "type": "string",
          "description": "Product model family",
          "minLength": 1
        },
        "model_name": {
          "type": "string",
          "description": "Full product name",
          "minLength": 1
        },
        "data_sheet_link": {
          "type": "string",
          "format": "uri",
          "description": "URL to product data sheet"
        },
        "skus": {
          "type": "array",
          "description": "Array of SKU numbers",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "number_of_inputs_and_outputs": {
          "$ref": "#/$defs/inputsOutputs"
        },
        "safe_operating_temperature": {
          "$ref": "#/$defs/temperatureRange"
        },
        "firmware": {
          "$ref": "#/$defs/firmware"
        },
        "images": {
          "type": "array",
          "description": "Product images",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "dsp_architecture": {
          "type": "string",
          "description": "DSP architecture type"
        },
        "acoustic_echo_cancellation": {
          "type": "object",
          "description": "Acoustic echo cancellation specifications",
          "properties": {
            "channels": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "configuration_software": {
          "type": "string",
          "description": "Configuration software name"
        },
        "supported_bose_professional_dante_endpoints": {
          "type": "array",
          "description": "Supported Bose Professional Dante endpoints",
          "items": {
            "type": "string"
          }
        },
        "dimensions": {
          "type": "object",
          "description": "Product dimensions",
          "properties": {
            "rack_space": {
              "type": "string",
              "description": "Rack space requirement"
            },
            "size": {
              "type": "array",
              "description": "Dimensions in different units",
              "items": {
                "$ref": "#/$defs/dimensions"
              }
            }
          },
          "additionalProperties": false
        },
        "net_weight": {
          "type": "array",
          "description": "Product weight in different units",
          "items": {
            "$ref": "#/$defs/valueWithUnit"
          }
        },
        "product_codes": {
          "type": "array",
          "description": "Product ordering codes",
          "items": {
            "type": "string"
          }
        },
        "updated_at": {
          "type": "string",
          "format": "epoch",
          "description": "Timestamp of when this DSP was last updated"
        }
      },
      "required": [
        "id",
        "model_name",
        "model_family",
        "skus",
        "number_of_inputs_and_outputs"
      ],
      "additionalProperties": false
    },
    "controller": {
      "type": "object",
      "title": "Controller Product",
      "description": "Bose Professional controller product specification",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique product identifier",
          "minimum": 1
        },
        "model_family": {
          "type": "string",
          "description": "Product model family"
        },
        "model_name": {
          "type": "string",
          "description": "Product model name"
        },
        "data_sheet_link": {
          "type": "string",
          "format": "uri",
          "description": "URL to product data sheet"
        },
        "skus": {
          "type": "array",
          "description": "Array of SKU numbers",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "zone_control_count": {
          "type": "string",
          "description": "Zone control capability",
          "enum": [
            "SingleOrMultiPleZone",
            "Single",
            "Multiple"
          ]
        },
        "control_type": {
          "type": "string",
          "description": "Control interface type",
          "enum": [
            "EncoderOrTouchscreen",
            "Encoder",
            "Touchscreen",
            "Button"
          ]
        },
        "additional_sensors": {
          "type": "array",
          "description": "Additional sensors available",
          "items": {
            "type": "string",
            "enum": [
              "Proximity",
              "microphone",
              "ambient_light",
              "motion"
            ]
          }
        },
        "images": {
          "type": "array",
          "description": "Product images by color",
          "items": {
            "$ref": "#/$defs/productImages"
          }
        },
        "physical_size": {
          "type": "string",
          "description": "Physical size description"
        },
        "applicable_regions": {
          "type": "array",
          "description": "Applicable regions",
          "items": {
            "type": "string"
          }
        },
        "updated_at": {
          "type": "string",
          "format": "epoch",
          "description": "Timestamp of when this controller was last updated"
        }
      },
      "required": [
        "id",
        "model_family",
        "model_name",
        "zone_control_count",
        "images",
        "control_type",
        "additional_sensors"
      ],
      "additionalProperties": false
    },
    "ioEndpoint": {
      "type": "object",
      "title": "I/O Endpoint Product",
      "description": "Bose Professional I/O endpoint product specification",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique product identifier",
          "minimum": 1
        },
        "model_family": {
          "type": "string",
          "description": "Product model family"
        },
        "model_name": {
          "type": "string",
          "description": "Product model name"
        },
        "data_sheet_link": {
          "type": "string",
          "format": "uri",
          "description": "URL to product data sheet"
        },
        "skus": {
          "type": "array",
          "description": "Array of SKU numbers",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "number_of_inputs_and_outputs": {
          "$ref": "#/$defs/inputsOutputs"
        },
        "images": {
          "$ref": "#/$defs/productImages"
        },
        "updated_at": {
          "type": "string",
          "format": "epoch",
          "description": "Timestamp of when this I/O endpoint was last updated"
        }
      },
      "required": [
        "id",
        "model_family",
        "model_name",
        "skus",
        "number_of_inputs_and_outputs",
        "images"
      ],
      "additionalProperties": false
    },
    "accessory": {
      "type": "object",
      "title": "Accessory Product",
      "description": "Additional accessory product specification",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique accessory identifier",
          "minimum": 1
        },
        "model_name": {
          "type": "string",
          "description": "Accessory Model name",
          "minLength": 1
        },
        "data_sheet_link": {
          "type": "string",
          "format": "uri",
          "description": "URL to product data sheet"
        },
        "model_family": {
          "type": "string",
          "description": "Accessory model family"
        },
        "skus": {
          "type": "array",
          "description": "SKU identifier"
        },
         "images": {
          "$ref": "#/$defs/productAccessoryImages"
        },
        "type": {
          "type": "string",
          "description": "Accessory type",
          "enum": [
            "included",
            "optional",
            "required"
          ]
        },
        "quantity": {
          "type": "integer",
          "description": "Quantity",
          "minimum": 1
        },
        "sku": {
          "type": "string",
          "description": "SKU identifier"
        },
        "updated_at": {
          "type": "string",
          "format": "epoch",
          "description": "Timestamp of when this accessory was last updated"
        }
      },
      "required": [
        "model_name",
        "model_family",
        "type",
        "quantity",
        "skus", 
        "images"
      ],
      "additionalProperties": false
    },
    "powerHandling": {
      "type": "object",
      "title": "Power Handling Specification",
      "properties": {
        "unit": {
          "type": "string",
          "const": "Watts"
        },
        "long_term_rms": {
          "type": "number",
          "minimum": 0
        },
        "peak": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "unit",
        "long_term_rms",
        "peak"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "title": "Measurement with Unit",
      "oneOf": [
        {
          "properties": {
            "unit": {
              "type": "string"
            },
            "at": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "at": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "impedance": {
                    "$ref": "#/$defs/valueWithUnit"
                  },
                  "power": {
                    "$ref": "#/$defs/valueWithUnit"
                  },
                  "voltage": {
                    "$ref": "#/$defs/valueWithUnit"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "at"
          ],
          "additionalProperties": false
        }
      ]
    },
    "valueWithUnit": {
      "type": "object",
      "title": "Value with Unit",
      "properties": {
        "unit": {
          "type": "string"
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "unit",
        "value"
      ],
      "additionalProperties": false
    },
    "frequencyRange": {
      "type": "object",
      "title": "Frequency Range",
      "properties": {
        "unit": {
          "type": "string",
          "const": "Hz"
        },
        "low": {
          "type": "number",
          "minimum": 0
        },
        "high": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "unit",
        "low",
        "high"
      ],
      "additionalProperties": false
    },
    "frequencyResponse": {
      "type": "object",
      "title": "Frequency Response",
      "properties": {
        "at": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "$ref": "#/$defs/valueWithUnit"
              },
              "range": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "const": "Hz"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "unit"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "level",
              "range"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "at"
      ],
      "additionalProperties": false
    },
    "frequencyResponsePoint": {
      "type": "object",
      "title": "Frequency Response Point",
      "properties": {
        "frequency_hz": {
          "type": "number",
          "minimum": 0
        },
        "level_db": {
          "type": "number"
        }
      },
      "required": [
        "frequency_hz",
        "level_db"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "title": "Coverage Pattern",
      "properties": {
        "frequency_range": {
          "type": "object",
          "properties": {
            "low": {
              "$ref": "#/$defs/valueWithUnit"
            },
            "high": {
              "$ref": "#/$defs/valueWithUnit"
            }
          },
          "required": [
            "low",
            "high"
          ],
          "additionalProperties": false
        },
        "type": {
          "type": "string",
          "enum": [
            "rectangular",
            "conical",
            "line_array"
