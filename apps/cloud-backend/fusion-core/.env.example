# ==============================================================================
# FUSION CLOUD BACKEND - ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to .env and update values according to your environment
# ==============================================================================

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL database connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fusion_cloud
POSTGRES_PASS=your_database_password
POSTGRES_INSTANCE=fusion_cloud
POSTGRES_SSL_MODE=disable

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# API server binding settings
API_HOST=localhost
API_PORT=8080
SYNC_PORT=8081

# ==============================================================================
# AWS CONFIGURATION
# ==============================================================================
# AWS credentials and region settings
AWS_REGION=us-east-2
AWS_PROFILE=your-aws-profile

# ==============================================================================
# PROCESSING CONFIGURATION
# ==============================================================================
# Background job processing settings
MAX_WORKERS=5
BATCH_SIZE=50
RETRY_ATTEMPTS=3
RETRY_DELAY=2

# ==============================================================================
# VALIDATION CONFIGURATION
# ==============================================================================
# Data validation settings
REQUIRE_VERSION=true
DEFAULT_VERSION=1.0
SUPPORTED_VERSIONS=1.0,1.1,2.0,3.0

# ==============================================================================
# AWS S3 CONFIGURATION
# ==============================================================================
# S3 bucket for project data
S3_PROJECT_BUCKET=your-s3-bucket-name

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
# General application settings
LOG_LEVEL=info
SCHEMA_PATH=project-data-standard-schema.json

# ==============================================================================
# AWS SECRETS MANAGER CONFIGURATION
# ==============================================================================
# Set to true to use AWS Secrets Manager instead of environment variables
USE_SECRETS_MANAGER=false

# Secret names in AWS Secrets Manager (required when USE_SECRETS_MANAGER=true)
POSTGRES_SECRET_NAME=your-postgres-secret-name
APP_CONFIG_SECRET_NAME=your-app-config-secret-name

# ==============================================================================
# PRODUCTION SECRETS MANAGER EXAMPLE
# ==============================================================================
# When using AWS Secrets Manager in production, create these secrets:
#
# Secret Name: your-postgres-secret-name (e.g., "fusion-rds")
# Content: {
#   "username": "your_db_user",
#   "password": "your_db_password", 
#   "host": "your-rds-host.amazonaws.com",
#   "port": 5432,
#   "dbname": "your_database_name"
# }
#
# Secret Name: your-app-config-secret-name (e.g., "fusion-sync-jobs")  
# Content: {
#   "API_HOST": "0.0.0.0",
#   "API_PORT": "8080",
#   "SYNC_PORT": "8081",
#   "AWS_REGION": "us-east-2",
#   "AWS_PROFILE": "your-production-profile",
#   "SUPPORTED_VERSIONS": "1.0,1.1,2.0",
#   "REQUIRE_VERSION": "true",
#   "DEFAULT_VERSION": "1.0",
#   "MAX_WORKERS": "10",
#   "BATCH_SIZE": "100",
#   "RETRY_ATTEMPTS": "5",
#   "RETRY_DELAY": "3",
#   "POSTGRES_SSL_MODE": "require"
# }

# ==============================================================================
# USAGE MODES
# ==============================================================================
#
# Local Development:
#   go run cmd/api/main.go -e local
#   - Uses all values from .env file
#   - No AWS Secrets Manager
#
# Production with Secrets Manager:
#   go run cmd/api/main.go -secrets -e prod  
#   - Uses AWS Secrets Manager for config values
#   - Uses .env for secret names only (POSTGRES_SECRET_NAME, APP_CONFIG_SECRET_NAME)
#   - Requires: aws sso login --profile your-aws-profile
#
# Production with Environment Variables:
#   go run cmd/api/main.go -e prod
#   - Uses system environment variables only
#   - No .env file loaded
#   - All variables must be set in the environment
#
# ==============================================================================