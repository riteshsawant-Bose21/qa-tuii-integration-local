POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_INSTANCE=fusion_cloud
POSTGRES_SSL_MODE=disable

S3_PROJECT_BUCKET=bose.cloud-backend.test
S3_PRODUCT_BUCKET=bose.cloud-backend.test
S3_PRICE_BUCKET=bose.cloud-backend.test
S3_REGION=us-east-2
IOT_ENDPOINT=
IOT_COMMAND_TOPIC=cluster/{projectID}/command
IOT_DEVICE_POLICY=testdevicepolicy
AWS_REGION=us-east-2
AUTH0_DOMAIN=id-dev.boseprofessional.com
AUTH0_ACCESS_TOKEN_ENDPOINT=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Only enable in QA/testing environments
AUTH0_RESOURCE_OWNER_PASSWORD_FLOW_ENABLED=true

# Default password for QA test users
AUTH0_TEST_USER_DEFAULT_PASSWORD=
API_HOST=0.0.0.0
API_PORT=8080
SWAGGER_HOST=0.0.0.0:8080
RELEASE_MODE=local
LOG_LEVEL=debug
LOG_DIR=/tmp/

# Processing Configuration
MAX_WORKERS=5
BATCH_SIZE=50
RETRY_ATTEMPTS=3
RETRY_DELAY=2

# Validation Configuration
REQUIRE_VERSION=true
DEFAULT_VERSION=2.0
SUPPORTED_VERSIONS=1.0,1.1,2.0,1.0.0,1.0.1,2.0.1,3.0.0