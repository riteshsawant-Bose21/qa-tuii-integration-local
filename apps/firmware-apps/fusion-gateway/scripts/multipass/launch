#!/bin/bash
set -eu

if [ ! -f multipass.env ]; then
    cp multipass_template.env multipass.env
fi
source multipass.env

BASE_NAME=""
KILL_BASE_NAME="fusion"
NUM_INSTANCES=""
JOIN_ADDRESS=""
KILL_MODE=false
RESYNC_TIME=false
# HOST_OS_ARCH and TARGET_BINARY_ARCH are set in check_platform_arch
# These will use 'arm64' or 'amd64' (not x86-64)
HOST_OS_ARCH=""
TARGET_BINARY_ARCH=""

# Host directories are set in `host_setup`
HOST_TEMP_DIR=
HOST_BUILD_DIR=
HOST_BBOLT_DIR=

# Color and formatting definitions
declare -r RED='\033[0;31m'
declare -r GREEN='\033[0;32m'
declare -r YELLOW='\033[1;33m'
declare -r BLUE='\033[0;34m'
declare -r CYAN='\033[0;36m'
declare -r BOLD='\033[1m'
declare -r NC='\033[0m' # No Color
declare -r HEADER_LINE='━'
declare -r CHECK_MARK='✓'
declare -r CROSS_MARK='✗'
declare -r ARROW='→'


# Function to display usage
usage() {
    echo "Usage: $0 [--name base_name] [--instances number_of_instances] [--kill [base_name]]"
    echo "  --name          : Base name for instances (default: fusion)"
    echo "  --instances     : Number of instances to create (default: 1)"
    echo "  --kill          : Delete and purge all instances with the specified base name"
    echo "                    Can be followed by base name or used with --name"
    echo " --resync-time    : Synchronize time between all instances"
    echo "  --verbose       : Show detailed status output during setup and verification"
    exit 1
}

detect_network_settings() {
    
    echo "Detecting functional Multipass network..."

    # Find any running instance to query
    local sample_instance
    sample_instance=$(multipass list --format csv | awk -F, 'NR>1 && $2=="Running"{print $1;exit}')
    if [[ -z "$sample_instance" ]]; then
        echo "No running instances yet; using defaults."
        export VIRTUAL_IP=${VIRTUAL_IP:-192.168.2.100}
        export NET_INTERFACE=${NET_INTERFACE:-enp0s1}
        return
    fi

    # Determine which subnet is actually reachable from host
    local host_pingable_ip
    host_pingable_ip=$(multipass info "$sample_instance" | awk '/IPv4/{print $2}' | while read ip; do
        if ping -c1 -W100 "$ip" >/dev/null 2>&1; then echo "$ip"; break; fi
    done)

    local subnet_base
    subnet_base=$(echo "$host_pingable_ip" | awk -F. '{print $1"."$2"."$3}')
    export VIRTUAL_IP="${subnet_base}.100"

    # Find which interface inside the VM carries that subnet
    export NET_INTERFACE=$(
    multipass exec "$sample_instance" -- ip -o -4 addr show |
    while read -r idx iface proto addr rest; do
        # addr comes in like: 192.168.2.34/24
        ip_clean="${addr%%/*}"   # strip "/mask"
        if [[ "$ip_clean" == "$subnet_base."* ]]; then
            echo "$iface"
            break
        fi
    done
    )

    echo "Detected functional subnet: ${subnet_base}.x"
    echo "Setting VIP=$VIRTUAL_IP  interface=$NET_INTERFACE"
}

# Function to check and enable IP forwarding
check_ip_forwarding() {
    if [[ "$(uname)" == "Darwin" ]]; then  # Check if running on macOS
        if [ $(sysctl -n net.inet.ip.forwarding) -eq 0 ]; then
            echo "Enabling IP forwarding..."
            if ! sudo sysctl -w net.inet.ip.forwarding=1; then
                echo "Failed to enable IP forwarding. Please run script with sudo or enable manually."
                exit 1
            fi
            echo "IP forwarding enabled successfully."
        fi
    fi
}

# Function to handle cleanup when script exits
cleanup() {
    [ "$VERBOSE" = true ] && echo
    [ "$VERBOSE" = true ] && echo "Cleaning up..."
    
    # Clean up temporary cloud-init files
    [ "$VERBOSE" = true ] && echo "Cleaning up temporary cloud-init files..."
    rm -f "$HOST_TEMP_DIR"/fusion-gateway.yaml 2>/dev/null
    
    # Remove generated cloud config file
    rm fusion-gateway.yaml 2>/dev/null
}

# Helper functions for formatted output
print_header() {
    local text="$1"
    local width=60
    local padding=$(( (width - ${#text}) / 2 ))
    echo
    printf "%${width}s\n" | sed "s/ /$HEADER_LINE/g"
    printf "%${padding}s${BOLD}%s${NC}%${padding}s\n" "" "$text" ""
    printf "%${width}s\n" | sed "s/ /$HEADER_LINE/g"
}

print_step() {
    printf "${BLUE}${ARROW} ${BOLD}%s${NC}\n" "$1"
}

print_substep() {
    printf "  ${CYAN}${ARROW} %s${NC}\n" "$1"
}

print_success() {
    printf "${GREEN}${CHECK_MARK} %s${NC}\n" "$1"
}

print_error() {
    printf "${RED}${CROSS_MARK} %s${NC}\n" "$1"
}

print_warning() {
    printf "${YELLOW}⚠ %s${NC}\n" "$1"
}

print_progress() {
    local current=$1
    local total=$2
    local text=$3
    local width=50
    local percentage=$((current * 100 / total))
    local progress=$((current * width / total))
    
    printf "\r  ${CYAN}[%-${width}s] %d%% %s${NC}" \
           "$(printf '%0.s█' $(seq 1 $progress))" \
           "$percentage" \
           "$text"
    
    if [ "$current" -eq "$total" ]; then
        echo
    fi
}

# SSH key path for direct SSH fallback (multipass 1.16.1 bug workaround)
MULTIPASS_SSH_KEY="/var/root/Library/Application Support/multipassd/ssh-keys/id_rsa"

# Helper function to get instance IP
get_instance_ip() {
    local instance_name="$1"
    multipass info "$instance_name" 2>/dev/null | awk '/IPv4/{print $2; exit}'
}

# Wrapper for multipass exec with direct SSH fallback
mp_exec() {
    local instance_name="$1"
    shift
    local cmd="$*"
    
    # Try multipass exec first
    if multipass exec "$instance_name" -- $cmd 2>/dev/null; then
        return 0
    fi
    
    # Fall back to direct SSH
    local ip=$(get_instance_ip "$instance_name")
    if [ -n "$ip" ]; then
        sudo ssh -i "$MULTIPASS_SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR ubuntu@"$ip" "$cmd" 2>/dev/null
        return $?
    fi
    return 1
}

# Wrapper for multipass transfer with direct SCP fallback
mp_transfer() {
    local src="$1"
    local dest="$2"
    
    # Try multipass transfer first
    if multipass transfer "$src" "$dest" 2>/dev/null; then
        return 0
    fi
    
    # Parse destination (instance_name:/path)
    local instance_name="${dest%%:*}"
    local remote_path="${dest#*:}"
    local ip=$(get_instance_ip "$instance_name")
    
    if [ -n "$ip" ]; then
        sudo scp -i "$MULTIPASS_SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$src" ubuntu@"$ip":"$remote_path" 2>/dev/null
        return $?
    fi
    return 1
}

show_instance_status() {
    local instance_name="$1"
    
    if [ "$VERBOSE" = true ]; then
        print_header "Instance Status: $instance_name"
        
        print_step "Network Configuration"
        mp_exec "$instance_name" networkctl status
        
        print_step "Service Status"
        for service in fusion-gateway keepalived haproxy chrony; do
            echo
            printf "${CYAN}=== %s ===${NC}\n" "$service"
            mp_exec "$instance_name" systemctl status "$service" --no-pager || true
        done
        
        print_step "IP Configuration"
        mp_exec "$instance_name" ip addr show

        print_step "Process Status"
        mp_exec "$instance_name" "ps aux | grep -E 'fusion-gateway|keepalived|haproxy|chrony'" || true
    else
        print_header "Basic Status: $instance_name"
        for service in fusion-gateway keepalived haproxy chrony; do
            status=$(mp_exec "$instance_name" systemctl is-active "$service" || echo "inactive")
            if [ "$status" = "active" ]; then
                print_success "$service is running"
            else
                print_error "$service is $status"
            fi
        done
    fi
}

system_checks() {

    print_step "System checks"

    # Note: `check_platform_arch` sets HOST_OS_ARCH and TARGET_BINARY_ARCH
    if ! check_platform_arch; then
        exit 1
    fi

    check_ip_forwarding
}

verify_instance() {
    local instance_name="$1"
    local max_retries=30
    local retry_count=0
    
    print_header "Verifying Instance: $instance_name"
    
    print_step "Checking Services"
    while [ $retry_count -lt $max_retries ]; do
        # Check if binary exists
        if ! mp_exec "$instance_name" test -x /usr/local/bin/fusion-gateway; then
            print_progress $retry_count $max_retries "Waiting for fusion-gateway binary..."
            sleep 5
            ((retry_count++))
            continue
        fi
        
        # Check services one by one
        local all_services_running=true
        for service in fusion-gateway keepalived haproxy; do
            if ! mp_exec "$instance_name" systemctl is-active --quiet "$service"; then
                print_warning "Service $service is not running"
                all_services_running=false
                break
            fi
        done
        
        if [ "$all_services_running" = true ]; then
            print_success "All services are running on $instance_name"
            print_substep "Checking VIP accessibility..."
            
            local response
            response=$(mp_exec "$instance_name" curl -sf http://$VIRTUAL_IP:8080 2>/dev/null)
            if [ $? -eq 0 ]; then
                print_success "VIP is accessible"
                printf "${CYAN}Server response: ${NC}%s\n" "$response"
                return 0
            else
                print_warning "VIP is not accessible yet (attempt $((retry_count + 1))/$max_retries)"
            fi
        fi
        
        print_progress $retry_count $max_retries "Waiting for services to start..."
        sleep 5
        ((retry_count++))
    done
    
    print_error "Services failed to start on $instance_name after $max_retries attempts"
    [ "$VERBOSE" = true ] && show_instance_status "$instance_name"
    return 1
}

setup_instance() {
    local instance_name="$1"
    local instance_number="$2"
    
    print_header "Setting Up Instance: $instance_name"
    
    # Wait for the instance to be ready for SSH connections
    print_step "Waiting for instance to be ready..."
    local max_wait_retries=60
    local wait_count=0
    local instance_ip=$(get_instance_ip "$instance_name")
    
    while [ $wait_count -lt $max_wait_retries ]; do
        # Check if instance is running via multipass info (avoids TTY bug with exec + stdout redirect in 1.16.1)
        # Then verify SSH connectivity without redirecting stdout
        if multipass info "$instance_name" 2>/dev/null | grep -q "State:.*Running"; then
            # Test actual SSH connectivity - only redirect stderr (stdout redirect causes hang in 1.16.1)
            if multipass exec "$instance_name" -- true 2>/dev/null; then
                print_success "Instance is ready for connections"
                break
            fi
        fi
        # Direct SSH fallback
        instance_ip=$(get_instance_ip "$instance_name")
        if [ -n "$instance_ip" ] && sudo ssh -i "$MULTIPASS_SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=3 -o LogLevel=ERROR ubuntu@"$instance_ip" true 2>/dev/null; then
            print_success "Instance is ready for connections (direct SSH)"
            break
        fi
        print_progress $wait_count $max_wait_retries "Waiting for SSH connectivity..."
        sleep 2
        ((wait_count++))
    done
    
    if [ $wait_count -ge $max_wait_retries ]; then
        print_error "Instance failed to become ready for SSH connections"
        return 1
    fi
    
    # Wait for cloud-init to complete
    # Note: Only redirect stderr - stdout redirect causes hang in multipass 1.16.1
    print_step "Waiting for cloud-init to complete..."
    if mp_exec "$instance_name" cloud-init status --wait 2>/dev/null; then
        print_success "Cloud-init completed"
    else
        print_warning "Cloud-init may not have completed properly"
    fi
        
    print_step "Copying fusion-gateway binary..."
    if ! mp_transfer "$HOST_BUILD_DIR/fusion-gateway" "$instance_name":/tmp/; then
        print_error "Failed to copy fusion-gateway binary"
        return 1
    fi
    print_success "fusion-gateway copied successfully"
    
    print_step "Installing fusion-gateway..."
    if ! mp_exec "$instance_name" sudo cp /tmp/fusion-gateway /usr/local/bin/ || \
       ! mp_exec "$instance_name" sudo chmod 755 /usr/local/bin/fusion-gateway || \
       ! mp_exec "$instance_name" rm /tmp/fusion-gateway; then
        print_error "Failed to install fusion-gateway binary"
        return 1
    fi
    print_success "fusion-gateway installed successfully"
    
    # Set the script used by systemd to launch fusion-gateway to executable
    if ! mp_exec "$instance_name" sudo chmod 755 /usr/local/bin/fusion-gateway-start.sh; then
        print_error "Failed to update fusion-gateway-start.sh"
        return 1
    fi

    print_step "Copying bbolt binary..."
    if ! mp_transfer "$HOST_BBOLT_DIR/bbolt-linux-$TARGET_BINARY_ARCH" "$instance_name":/tmp/bbolt; then
        print_error "Failed to copy bbolt binary"
        return 1
    fi
    print_success "bbolt copied successfully"

    print_step "Installing bbolt..."
    if ! mp_exec "$instance_name" sudo cp /tmp/bbolt /usr/local/bin/ || \
       ! mp_exec "$instance_name" sudo chmod 755 /usr/local/bin/bbolt || \
       ! mp_exec "$instance_name" rm /tmp/bbolt; then
        print_error "Failed to install bbolt binary"
        return 1
    fi
    print_success "bbolt installed successfully"

    print_step "Configuring keepalived priority..."
    local priority=$((100 - instance_number))
    mp_exec "$instance_name" sudo sed -i "s/priority 100/priority ${priority}/" /etc/keepalived/keepalived.conf
    print_success "Priority set to $priority"
    
    print_step "Starting services..."
    local services_started=true

    # Do daemon-reload once before starting services
    print_substep "Reloading systemd daemon..."
    if ! mp_exec "$instance_name" sudo systemctl daemon-reload; then
        print_error "Failed to reload systemd daemon"
        services_started=false
    else
        print_success "Daemon reload completed"
        
        # Now start each service
        for service in fusion-gateway keepalived haproxy; do
            print_substep "Starting $service..."
            
            # Enable service without starting
            if ! mp_exec "$instance_name" sudo systemctl enable "$service"; then
                print_error "Failed to enable $service"
                services_started=false
                break
            fi
            
            # Start service
            if ! mp_exec "$instance_name" sudo systemctl start "$service"; then
                print_error "Failed to start $service"
                services_started=false
                break
            fi
            
            # Verify service is running
            if ! mp_exec "$instance_name" sudo systemctl is-active --quiet "$service"; then
                print_error "$service on $instance_name failed to start properly"
                services_started=false
                break
            fi
            
            print_success "$service started successfully"
        done
    fi

    if [ "$services_started" = false ]; then
        return 1
    fi
    
    print_step "Synchronizing time..."    
    mp_exec "$instance_name" sudo chronyc makestep || true
    mp_exec "$instance_name" sudo ntpdate pool.ntp.org || true

    [ "$VERBOSE" = true ] && show_instance_status "$instance_name"
    
    return 0
}

launch_instance() {
    local instance_name="$1"
    local instance_number="$2"

    local cloud_init_file="$HOST_TEMP_DIR/fusion-gateway.yaml"

    # Copy to an accesible location. Linux default security for the multipass
    # snap prevents open access to the local filesystem.
    cp fusion-gateway.yaml "$cloud_init_file"
    print_header "Launching Instance: $instance_name"
    
    # Create and launch instance
    print_step "Creating multipass instance..."
    if ! multipass launch jammy --name "$instance_name" --cloud-init "$cloud_init_file" --memory 2G --cpus 2; then
        print_error "Failed to launch instance $instance_name"
        return 1
    fi
    print_success "Instance launched successfully"
    
    # Retrieve the assigned IP address
    local instance_ip
    instance_ip=$(multipass info "$instance_name" | awk '/IPv4/{print $2}')
    
    if [ -z "$instance_ip" ]; then
        print_error "Failed to retrieve IP address for $instance_name"
        return 1
    fi
    
    print_step "Instance IP: $instance_ip"
    
    # Setup the instance
    if ! setup_instance "$instance_name" "$instance_number"; then
        print_error "Failed to setup instance $instance_name"
        return 1
    fi

    # Verify the instance
    if ! verify_instance "$instance_name"; then
        print_error "Failed to verify instance $instance_name"
        return 1
    fi

    print_success "Instance $instance_name is ready"
    return 0
}

to_lower() {
    echo "$1" | tr '[:upper:]' '[:lower:]'
}

prompt_base_name() {
    local default="fusion"
    printf "${YELLOW}Enter base name for instances [${default}]: ${NC}"
    read -r input_base_name
    echo "${input_base_name:-$default}"
}

prompt_num_instances() {
    local default=1
    printf "${YELLOW}Enter number of instances [${default}]: ${NC}"
    read -r input_num
    echo "${input_num:-$default}"
}

prompt_yes_no() {
    local question="$1"
    local default="${2:-n}"  # Default to 'n' if not specified
    
    while true; do
        if [ "$default" = "y" ]; then
            printf "${YELLOW}${question} [Y/n]${NC} "
        else
            printf "${YELLOW}${question} [y/N]${NC} "
        fi
        
        read -r answer
        
        # Default handling
        if [ -z "$answer" ]; then
            answer=$default
        fi
        
        answer=$(to_lower "$answer")
        
        case "$answer" in
            y|yes)
                return 0
                ;;
            n|no)
                return 1
                ;;
            *)
                print_warning "Please answer 'yes' or 'no'"
                ;;
        esac
    done
}

check_existing_instances() {
    local base_name="$1"
    local existing_instances=()
    
    print_step "Checking for existing instances..."
    
    # Get list of existing instances matching base name
    while IFS=, read -r name state ipv4 release; do
        if [[ "$name" == "$base_name"* ]]; then
            existing_instances+=("$name")
        fi
    done < <(multipass list --format csv)
    
    if [ ${#existing_instances[@]} -gt 0 ]; then
        print_warning "Found existing instances:"
        for instance in "${existing_instances[@]}"; do
            local state=$(multipass info "$instance" | grep "State:" | awk '{print $2}')
            printf "  ${CYAN}${ARROW} %s (State: %s)${NC}\n" "$instance" "$state"
        done
        
        if prompt_yes_no "Would you like to delete these instances and continue?"; then
            print_step "Removing existing instances..."
            
            for instance in "${existing_instances[@]}"; do
                print_substep "Deleting instance: $instance"
                if ! multipass delete "$instance"; then
                    print_error "Failed to delete instance: $instance"
                    return 1
                fi
            done
            
            print_substep "Purging deleted instances..."
            if ! multipass purge; then
                print_error "Failed to purge instances"
                return 1
            fi
            
            print_success "Successfully removed existing instances"
            return 0
        else
            print_warning "Aborting due to existing instances"
            exit 1
        fi
    fi
    
    print_success "No existing instances found with base name: $base_name"
    return 0
}

check_platform_arch() {
    # Multipass cannot run a cross-architecture target OS, so we check that the 
    # build/fusion-gateway symlink points to a platform-compatible binary.
    # This avoids building and running a multipass instance just to find out the fusion-gateway
    # copied in is not compatible.
    target_arch=$(file -bL build/fusion-gateway | awk -F ',' '{print $2}' | sed 's/^ //')
    host_arch=$(uname -m)
    TARGET_BINARY_ARCH=$host_arch
    host_os=$(uname | tr '[:upper:]' '[:lower:]')
    host_target_ok=false

    case "$host_arch" in
        'x86'_'64') 
            # x86_64 host can run x86-64 fusion-gateway.
            [ "$target_arch" = 'x86-64' ] && host_target_ok=true
            TARGET_BINARY_ARCH=amd64
            ;;
        'arm64') 
            # arm64 host can run aarch64 fusion-gateway in multipass.
            [ "$target_arch" = 'ARM aarch64' ] && host_target_ok=true
            ;;
    esac
    HOST_OS_ARCH="$host_os-$TARGET_BINARY_ARCH"

    if [ "$host_target_ok" = 'false' ]; then
        print_error "CPU architecture mismatch for fusion-gateway executable: Host=$host_arch, Target=$target_arch"
        return 1
    fi
}

host_setup() {
    # Perform and host configuration necessary to run multipass.
    # Use 'my_multipass_dir' so we don't have to keep checking for unbound MULTIPASS_DIR
    my_multipass_dir="${MULTIPASS_DIR:-}"

    if [ "$VERBOSE" ]; then
        echo "multipass.env environment:"
        echo "      VIRTUAL_IP: '$VIRTUAL_IP'"
        echo "   NET_INTERFACE: '$NET_INTERFACE'"
        echo "   MULTIPASS_DIR: '$my_multipass_dir'"
        echo ""
        echo "HOST_OS_ARCH: '$HOST_OS_ARCH'"
    fi

    if [ -n "$my_multipass_dir" ]; then
        # On a Linux host where 'multipass' is a snap, only the user's home
        # directory is accessible by snaps, so create a directory somewhere under
        # $HOME to use as the 'MULTIPASS_DIR' directory.
        HOST_TEMP_DIR="$my_multipass_dir/tmp"
        HOST_BUILD_DIR="$my_multipass_dir/build"
        HOST_BBOLT_DIR="$my_multipass_dir/tools/bbolt/cmd"
        mkdir -p "$HOST_TEMP_DIR"
        mkdir -p "$HOST_BUILD_DIR"
        mkdir -p "$HOST_BBOLT_DIR"
        # Copy the main binary to HOST_BUILD_DIR
        cp build/fusion-gateway "$HOST_BUILD_DIR/"
        # Copy the bbolt binary to HOST_BUILD_DIR
        cp "tools/bbolt/cmd/bbolt-linux-$TARGET_BINARY_ARCH" "$HOST_BBOLT_DIR/"
    else
        # Default host paths, works on MacOS.
        HOST_TEMP_DIR=/tmp
        HOST_BUILD_DIR=./build
        HOST_BBOLT_DIR=./tools/bbolt/cmd
    fi
    print_substep "Using HOST_TEMP_DIR=$HOST_TEMP_DIR"
    print_substep "Using HOST_BUILD_DIR=$HOST_BUILD_DIR"
    print_substep "Using HOST_BBOLT_DIR=$HOST_BBOLT_DIR"
}

resync_time_all_instances() {
    print_header "Resyncing Time and Network Configuration on All Instances"

    # Make sure we have up-to-date detection
    detect_network_settings

    local instances=()
    while IFS=, read -r name state ipv4 release; do
        if [[ "$name" == "Name" || "$state" != "Running" ]]; then
            continue
        fi
        if [[ "$name" =~ ^"$BASE_NAME" ]]; then
            instances+=("$name")
        fi
    done < <(multipass list --format csv)

    if [ ${#instances[@]} -eq 0 ]; then
        print_warning "No running instances found with base name: $BASE_NAME"
        return
    fi

    for instance in "${instances[@]}"; do
        print_step "Updating $instance to use VIP=$VIRTUAL_IP and interface=$NET_INTERFACE"

        multipass exec "$instance" -- bash -lc "
            echo 'Detected network interface in guest:'; ip -o -4 addr show | awk '{print \$2, \$4}'

            # Verify that the detected interface exists, fallback if missing
            if ! ip link show '$NET_INTERFACE' >/dev/null 2>&1; then
                NET_IFACE=\$(ip route list 0.0.0.0/0 | awk '{print \$5; exit}')
                echo 'Interface $NET_INTERFACE not found, using fallback:' \$NET_IFACE
            else
                NET_IFACE='$NET_INTERFACE'
            fi

            # Update keepalived configuration
            if [ -f /etc/keepalived/keepalived.conf ]; then
                sudo sed -i \
                    -e \"s/^  interface .*/  interface \$NET_IFACE/\" \
                    -e \"s/^  virtual_ipaddress.*/  virtual_ipaddress { $VIRTUAL_IP }/\" \
                    /etc/keepalived/keepalived.conf
                echo 'Updated keepalived.conf with interface='\$NET_IFACE' VIP=$VIRTUAL_IP'
                sudo systemctl restart keepalived || true
            fi

            # Export interface for fusion-gateway env
            echo \"export FUSION_NET_IFACE=\$NET_IFACE\" | sudo tee /etc/profile.d/fusion-netiface.sh >/dev/null
        " </dev/null

        print_substep "Synchronizing time on $instance..."
        if multipass exec "$instance" -- bash -lc '
            if command -v chronyc >/dev/null 2>&1; then
                sudo chronyc makestep >/dev/null 2>&1
                OFFSET=$(chronyc tracking | awk -F": " "/System time/{print \$2}")
                echo "OK:$OFFSET"
            elif command -v ntpdate >/dev/null 2>&1; then
                sudo ntpdate -b pool.ntp.org 2>&1 | awk "{print \"OK:\" \$0}"
            else
                echo "ERR:No NTP client found"
                exit 2
            fi
        ' 2>/dev/null | tee /tmp/chrony_status.$$ | grep -q "^OK:"; then
            OFFSET=$(grep "^OK:" /tmp/chrony_status.$$ | sed 's/^OK://')
            print_success "Time resynced on $instance ($OFFSET)"
        else
            print_error "Failed to resync time on $instance"
            tail -n1 /tmp/chrony_status.$$ | grep -v '^OK:' || true
        fi
        rm -f /tmp/chrony_status.$$ 2>/dev/null || true
    done
}

# Parse command line arguments
VERBOSE=''
while [[ $# -gt 0 ]]; do
    case $1 in
        --name)
            BASE_NAME="$2"
            shift 2
            ;;
        --instances)
            NUM_INSTANCES="$2"
            shift 2
            ;;
        --kill)
            KILL_MODE=true
            # Only check $2 if there is at least one more argument
            if [[ $# -ge 2 && "$2" != --* ]]; then
                KILL_BASE_NAME="$2"
                shift
            else
                echo "Using default base name: fusion."
            fi
            shift
            ;;
        --resync-time)
            RESYNC_TIME=true
            shift
            ;;
        --verbose)
            VERBOSE=true
            shift
            ;;
        *)
            usage
            ;;
    esac
done

# Handle kill mode first
if [ "$KILL_MODE" = true ]; then

     # Prompt for sudo credentials upfront if we'll need them for DHCP cleanup
    print_step "Requesting sudo access for DHCP cleanup..."
    sudo -v
    
    # If no specific kill base name provided, use the general base name
    if [ -z "$KILL_BASE_NAME" ]; then
        KILL_BASE_NAME="${BASE_NAME:-fusion}"
    fi
    print_header "Instance Cleanup"
    print_step "Checking for instances with base name: $KILL_BASE_NAME"
    
    # Get list of matching instances
    instances=()
    while IFS=, read -r name state ipv4 release; do
        if [[ "$name" =~ ^"$KILL_BASE_NAME" ]]; then
            instances+=("$name")
        fi
    done < <(multipass list --format csv)
    
    if [ ${#instances[@]} -eq 0 ]; then
        print_warning "No instances found matching base name: $KILL_BASE_NAME"
        exit 0
    fi
    print_substep "Found ${#instances[@]} instance(s) to remove:"
    for instance in "${instances[@]}"; do
        state=$(multipass info "$instance" | grep "State:" | awk '{print $2}')
        printf "  ${CYAN}${ARROW} %s (State: %s)${NC}\n" "$instance" "$state"
    done
    
    echo
    if ! prompt_yes_no "Are you sure you want to remove these instances?"; then
        print_warning "Operation cancelled by user"
        exit 0
    fi
    
    print_step "Removing instances..."
    for instance in "${instances[@]}"; do
        print_substep "Deleting instance: $instance"
        multipass delete "$instance"
    done
    
    print_step "Purging deleted instances..."
    multipass purge
    
    print_step "Cleaning up DHCP leases..."
    if [ -f /var/db/dhcpd_leases ]; then
        sudo rm /var/db/dhcpd_leases
        print_substep "Removed DHCP leases file"
        
        # Signal bootpd to reload (if it's running)
        if pgrep -q bootpd; then
            sudo pkill -HUP bootpd
            print_substep "Signaled bootpd to reload"
        fi
    else
        print_substep "No DHCP leases file found"
    fi
    
    print_success "Successfully removed ${#instances[@]} instance(s)"
    exit 0
fi

if [ "$RESYNC_TIME" = true ]; then
    resync_time_all_instances
    exit 0
fi

if [ -z "$NUM_INSTANCES" ]; then
    while true; do
        printf "${YELLOW}Enter number of instances [1]: ${NC}"
        read -r answer
        
        # Default to 1 if empty
        if [ -z "$answer" ]; then
            NUM_INSTANCES=1
            break
        fi
        
        # Validate input is a positive integer
        if [[ "$answer" =~ ^[0-9]+$ ]] && [ "$answer" -gt 0 ]; then
            NUM_INSTANCES=$answer
            break
        else
            print_warning "Please enter a positive number"
        fi
    done
fi

# Prompting for base name
if [ -z "$BASE_NAME" ]; then
    printf "${YELLOW}Enter base name for instances [fusion]: ${NC}"
    read -r input_base_name
    BASE_NAME="${input_base_name:-fusion}"
fi

# If number of instances not specified via arguments, prompt for it
if [ -z "$NUM_INSTANCES" ]; then
    while true; do
        printf "Enter number of instances [1]: "
        read -r answer
        
        # Default to 1 if empty
        if [ -z "$answer" ]; then
            NUM_INSTANCES=1
            break
        fi
        
        # Validate input is a positive integer
        if [[ "$answer" =~ ^[0-9]+$ ]] && [ "$answer" -gt 0 ]; then
            NUM_INSTANCES=$answer
            break
        else
            echo "Please enter a positive number"
        fi
    done
fi

system_checks
host_setup

# Set up trap but don't exit on errors
trap cleanup EXIT

echo
print_header "Starting Cluster Deployment"
echo
print_step "Configuration:"
print_substep "Base name: $BASE_NAME"
print_substep "Number of instances: $NUM_INSTANCES"
echo

if ! check_existing_instances "$BASE_NAME"; then
    exit 1
fi

# Generate base cloud-init
[ "$VERBOSE" = true ] && echo "Generating cloud-init configuration..."
./scripts/generate_cloud_config.sh > fusion-gateway.yaml

# Launch first instance
FIRST_INSTANCE="${BASE_NAME}1"
if ! launch_instance "$FIRST_INSTANCE" 1 ""; then
    echo "Failed to launch first instance"
    exit 1
fi

# Get the IP of the first instance
FIRST_IP=$(multipass info "$FIRST_INSTANCE" | grep IPv4 | head -1 | awk '{print $2}')
echo "First instance IP: $FIRST_IP"

# Launch additional instances if requested
if [ "$NUM_INSTANCES" -gt 1 ]; then
    for i in $(seq 2 "$NUM_INSTANCES"); do
        INSTANCE_NAME="${BASE_NAME}${i}"
        if ! launch_instance "$INSTANCE_NAME" "$i" "${FIRST_IP}:7946"; then
            echo "Failed to launch instance $INSTANCE_NAME"
            continue
        fi
    done
fi

echo "Cluster deployment complete!"
echo "Created instances with base name '$BASE_NAME':"
(multipass list | awk -v base="$BASE_NAME" '$0 ~ "^"base || $0 ~ /^[[:space:]]+/')
