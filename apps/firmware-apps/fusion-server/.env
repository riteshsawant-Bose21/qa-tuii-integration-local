FUSION_SERVER_IMAGE=fusion-gossip
NETWORK_PREFIX=172.18.0
GOSSIP_PORT=7946
DSP1_SUFFIX=3
DSP2_SUFFIX=4
DSP3_SUFFIX=5
DSP4_SUFFIX=6
DSP1_PORT=7946
DSP2_PORT=7947
DSP3_PORT=7948
DSP4_PORT=7949
DSP1_COMMAND=./fusion-gossip --name dsp1 --addr 0.0.0.0 --port ${GOSSIP_PORT}
DSP2_COMMAND=sh -c "./fusion-gossip --name dsp2 --addr 0.0.0.0 --port ${GOSSIP_PORT} ${NETWORK_PREFIX}.${DSP1_SUFFIX}:${GOSSIP_PORT}"
DSP3_COMMAND=sh -c "./fusion-gossip --name dsp3 --addr 0.0.0.0 --port ${GOSSIP_PORT} ${NETWORK_PREFIX}.${DSP1_SUFFIX}:${GOSSIP_PORT}"
DSP4_COMMAND=sh -c "./fusion-gossip --name dsp4 --addr 0.0.0.0 --port ${GOSSIP_PORT} ${NETWORK_PREFIX}.${DSP1_SUFFIX}:${GOSSIP_PORT}"

KEEPALIVED_VIP=172.18.0.2

KEEPALIVED_CONF=/etc/keepalived/keepalived.conf
KEEPALIVED_PRIMARY_CONF=/etc/keepalived/keepalived-primary.conf
KEEPALIVED_BACKUP1_CONF=/etc/keepalived/keepalived-backup1.conf
KEEPALIVED_BACKUP2_CONF=/etc/keepalived/keepalived-backup2.conf
KEEPALIVED_BACKUP3_CONF=/etc/keepalived/keepalived-backup3.conf