FUSION_SERVER_IMAGE=fusion-gossip
NETWORK_PREFIX=172.18.0
GOSSIP_PORT=7946

DSP1_SUFFIX=3
DSP2_SUFFIX=4
DSP3_SUFFIX=5
DSP4_SUFFIX=6

DSP1_PORT=7946
DSP2_PORT=7947
DSP3_PORT=7948
DSP4_PORT=7949

DSP1_COMMAND=./fusion-gossip --name dsp1 --addr 0.0.0.0 --port ${GOSSIP_PORT}
DSP2_COMMAND=./fusion-gossip --name dsp2 --addr 0.0.0.0 --port ${GOSSIP_PORT} ${NETWORK_PREFIX}.${DSP1_SUFFIX}:${GOSSIP_PORT}
DSP3_COMMAND=./fusion-gossip --name dsp3 --addr 0.0.0.0 --port ${GOSSIP_PORT} ${NETWORK_PREFIX}.${DSP1_SUFFIX}:${GOSSIP_PORT}
DSP4_COMMAND=./fusion-gossip --name dsp4 --addr 0.0.0.0 --port ${GOSSIP_PORT} ${NETWORK_PREFIX}.${DSP1_SUFFIX}:${GOSSIP_PORT}

NGINX_IMAGE=nginx:latest
NGINX_CONF_PATH=./nginx.conf

LB1_SUFFIX=7
LB2_SUFFIX=8

KEEPALIVED_IMAGE=osixia/keepalived:latest
KEEPALIVED_PLATFORM=linux/arm64
KEEPALIVED_PRIMARY_CONF=./keepalived-primary.conf
KEEPALIVED_BACKUP_CONF=./keepalived-backup.conf
KEEPALIVED1_SUFFIX=9
KEEPALIVED2_SUFFIX=10
KEEPALIVED_COMMAND=--dont-fork --log-console --log-detail --log-facility 7 --vrrp -f /usr/local/etc/keepalived/keepalived.conf
