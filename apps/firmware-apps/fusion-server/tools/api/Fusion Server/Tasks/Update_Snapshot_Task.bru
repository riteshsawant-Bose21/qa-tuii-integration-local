meta {
  name: Update Snapshot Task
  type: http
  seq: 11
}

patch {
  url: {{api_url}}/tasks/:id
  body: json
  auth: none
}

params:path {
  id: activate-snap-001
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cron_expr": "*/10 * * * *",
    "description": "Activate snapshot every ten minutes",
    "snapshot_id": "analog"
  }
}
