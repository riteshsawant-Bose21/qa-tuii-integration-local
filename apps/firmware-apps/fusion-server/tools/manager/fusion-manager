#!/bin/bash

# Set default base name
BASE_NAME=${1:-fusion}

# Helper Functions
format_status() {
    local status=$1
    if [ "$status" == "active" ]; then
        echo -e "\033[32m$status\033[0m"  # Green
    else
        echo -e "\033[31m$status\033[0m"  # Red
    fi
}

get_resource_usage() {
    local instance=$1
    local cpu_usage="N/A"
    local mem_usage="N/A"
    local disk_usage="N/A"

    # Get CPU usage
    if cpu_info=$(multipass exec "$instance" -- top -bn1 | grep '%Cpu'); then
        idle=$(echo "$cpu_info" | awk -F'[, ]+' '/id/{print $(NF-1)}')
        if [ ! -z "$idle" ]; then
            cpu_usage=$(printf "%.1f" $(echo "100 - $idle" | bc))
        fi
    fi

    # Get memory usage
    if mem_info=$(multipass exec "$instance" -- free | grep Mem:); then
        total=$(echo "$mem_info" | awk '{print $2}')
        used=$(echo "$mem_info" | awk '{print $3}')
        if [ ! -z "$total" ] && [ ! -z "$used" ] && [ "$total" -ne 0 ]; then
            mem_usage=$(printf "%.1f" $(echo "scale=2; $used * 100 / $total" | bc))
        fi
    fi

    # Get disk usage
    if disk_info=$(multipass exec "$instance" -- df / | tail -n 1); then
        disk_usage=$(echo "$disk_info" | awk '{print $5}')
    fi

    echo "$cpu_usage:$mem_usage:$disk_usage"
}

get_vip_info() {
    local instance=$1
    local vip_address=""
    local vip_port="8080"

    # Try to get VIP from keepalived config
    if config=$(multipass exec "$instance" -- sudo cat /etc/keepalived/keepalived.conf 2>/dev/null); then
        vip_address=$(echo "$config" | awk '/virtual_ipaddress/{getline; print $1}')
    fi

    # If not found, try to get from network interfaces
    if [ -z "$vip_address" ]; then
        all_ips=$(multipass exec "$instance" -- ip addr show | grep 'inet ' | grep -v '127.0.0.1' | awk '{print $2}' | cut -d/ -f1)
        instance_ips=$(multipass list --format json | jq -r '.list[].ipv4[]')
        
        while read -r ip; do
            if ! echo "$instance_ips" | grep -q "^$ip$"; then
                vip_address=$ip
                break
            fi
        done <<< "$all_ips"
    fi

    if [ ! -z "$vip_address" ]; then
        echo "$vip_address:$vip_port"
    fi
}

check_service_status() {
    local instance=$1
    local service=$2
    if status=$(multipass exec "$instance" -- systemctl is-active "$service" 2>/dev/null); then
        echo "$status"
    else
        echo "inactive"
    fi
}

# Commands
show_status() {
    echo -e "\n=== Cluster Status ===\n"

    # Get instances
    instances_json=$(multipass list --format json)
    instances=($(echo "$instances_json" | jq -r ".list[] | select(.name | startswith(\"$BASE_NAME\")) | .name"))
    
    echo "Total Instances: ${#instances[@]}"
    running_count=$(echo "$instances_json" | jq -r ".list[] | select(.name | startswith(\"$BASE_NAME\")) | select(.state==\"Running\") | .name" | wc -l)
    echo "Running Instances: $running_count"

    # Check VIP status
    echo -e "\n=== Virtual IP Status ===\n"
    vip_info=""
    active_node=""
    for instance in "${instances[@]}"; do
        if [ "$(check_service_status "$instance" "keepalived")" == "active" ]; then
            vip_info=$(get_vip_info "$instance")
            if [ ! -z "$vip_info" ]; then
                active_node=$instance
                break
            fi
        fi
    done

    if [ ! -z "$vip_info" ]; then
        vip_address=$(echo "$vip_info" | cut -d: -f1)
        vip_port=$(echo "$vip_info" | cut -d: -f2)
        echo "VIP Address: $vip_address"
        echo "VIP Port: $vip_port"
        echo "Active Node: $active_node"
    else
        echo "VIP Status: Not configured or not found"
    fi

    # Show instances table
    echo -e "\n=== Instances ===\n"
    printf "%-15s %-10s %-15s %-8s %-8s %-8s %s\n" \
        "Name" "State" "IPv4" "CPU%" "Mem%" "Disk" "VIP"
    echo "--------------------------------------------------------------------------------"

    for instance in "${instances[@]}"; do
        state=$(echo "$instances_json" | jq -r ".list[] | select(.name==\"$instance\") | .state")
        ipv4=$(echo "$instances_json" | jq -r ".list[] | select(.name==\"$instance\") | .ipv4[0]")
        
        if [ "$state" == "Running" ]; then
            resources=$(get_resource_usage "$instance")
            cpu=$(echo "$resources" | cut -d: -f1)
            mem=$(echo "$resources" | cut -d: -f2)
            disk=$(echo "$resources" | cut -d: -f3)
        else
            cpu="N/A"
            mem="N/A"
            disk="N/A"
        fi

        vip_marker=""
        if [ "$instance" == "$active_node" ]; then
            vip_marker="✓"
        fi

        state_color="\033[31m"  # Red
        if [ "$state" == "Running" ]; then
            state_color="\033[32m"  # Green
        fi

        printf "%-15s ${state_color}%-10s\033[0m %-15s %-8s %-8s %-8s %s\n" \
            "$instance" "$state" "${ipv4:-N/A}" "$cpu" "$mem" "$disk" "$vip_marker"
    done
}

inspect_instance() {
    local instance=$1
    
    echo -e "\n=== Services ===\n"
    for service in fusion-server keepalived haproxy; do
        status=$(check_service_status "$instance" "$service")
        status_formatted=$(format_status "$status")
        printf "%-15s %s\n" "$service:" "$status_formatted"
    done

    echo -e "\n=== Network Configuration ===\n"
    multipass exec "$instance" -- ip addr show
}

restart_service() {
    local instance=$1
    local service=$2

    if [[ ! "$service" =~ ^(fusion-server|keepalived|haproxy)$ ]]; then
        echo "Error: Invalid service name. Must be one of: fusion-server, keepalived, haproxy"
        exit 1
    fi

    echo "Restarting $service on $instance..."
    if multipass exec "$instance" -- sudo systemctl restart "$service"; then
        status=$(check_service_status "$instance" "$service")
        if [ "$status" == "active" ]; then
            echo -e "\033[32mService $service restarted successfully!\033[0m"
        else
            echo -e "\033[31mService $service failed to restart (status: $status)\033[0m"
            exit 1
        fi
    else
        echo -e "\033[31mError restarting service\033[0m"
        exit 1
    fi
}

# Main command processing
case ${2:-status} in
    status|s)
        show_status
        ;;
    inspect|i)
        if [ -z "$3" ]; then
            echo "Error: Instance name required"
            exit 1
        fi
        inspect_instance "$3"
        ;;
    restart|r)
        if [ -z "$3" ] || [ -z "$4" ]; then
            echo "Error: Instance name and service name required"
            exit 1
        fi
        restart_service "$3" "$4"
        ;;
    help|h)
        echo "Usage: $0 [base-name] [command] [args...]"
        echo
        echo "Commands:"
        echo "  status (s)                     Show cluster status (default)"
        echo "  inspect (i) <instance>         Show detailed instance information"
        echo "  restart (r) <instance> <svc>   Restart a service on an instance"
        echo "  help (h)                       Show this help message"
        ;;
    *)
        echo "Unknown command: $2"
        echo "Use '$0 help' for usage information"
        exit 1
        ;;
esac