# File: multpass.env
# This environment file is sourced by the 'launch' script to handle differences
# seen when running multipass on MacOS vs. Linux. To get any of this working on
# Windows will probably require rewriting all the scripts in Python (and special
# allowances from Bose Professional IT to install and run multipass).

# NET_INTERFACE
# -------------
# The internal network interface to use for keepalived. This was different in
# multipass instances for MacOS and Linux hosts. For MacOS hosts 'enp0s1'
# works. For one Linux host 'ens3' worked.
# Default: enp0s1
NET_INTERFACE=enp0s1

# VIRTUAL_IP
# ----------
# The virtual IP address (sometimes called "VIP" in fusion-server scripts) is 
# On MacOS which uses the Hypervisor framework a virtual switch is created with
# subnet 192.168.64.* # It is different on Linux. Try 10.14.1.100 for Linux, and
# if that doesn't work, check the IP of a running instance for the subnet it is
# using.
# Default: 192.168.64.100
VIRTUAL_IP=192.168.2.100

# MULTIPASS_DIR 
# --------------
# This is needed for Linux where multipass is a snap and doesn't have access
# to the whole filesystem by default (which is probably a good thing).
# Uncomment the 'MULTIPASS_DIR=' line below to set a location that is readable
# by multipass. Something like MULTIPASS_DIR=~/snap_temp should work.
# If needed, a location outside of $HOME could be configured using 
# `snap connect`.
# Default: <Not set>
#MULTIPASS_DIR=~/snap_temp

# Use an empty string if MULTIPASS_DIR is not set.
MULTIPASS_DIR=${MULTIPASS_DIR:-}  

# Export the variables so they are visible in subshells/scripts of 'launch'.
[ -n "$MULTIPASS_DIR" ] && export MULTIPASS_DIR
export NET_INTERFACE
export VIRTUAL_IP
