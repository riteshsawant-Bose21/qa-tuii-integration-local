#!/bin/bash
set -eu

if [ ! -f multipass.env ]; then
    cp multipass_template.env multipass.env
fi
source multipass.env

BASE_NAME=""
KILL_BASE_NAME="fusion"
NUM_INSTANCES=""
JOIN_ADDRESS=""
KILL_MODE=false
# HOST_OS_ARCH and TARGET_BINARY_ARCH are set in check_platform_arch
# These will use 'arm64' or 'amd64' (not x86-64)
HOST_OS_ARCH=""
TARGET_BINARY_ARCH=""

# Host directories are set in `host_setup`
HOST_TEMP_DIR=
HOST_BUILD_DIR=
HOST_BBOLT_DIR=

# Color and formatting definitions
declare -r RED='\033[0;31m'
declare -r GREEN='\033[0;32m'
declare -r YELLOW='\033[1;33m'
declare -r BLUE='\033[0;34m'
declare -r CYAN='\033[0;36m'
declare -r BOLD='\033[1m'
declare -r NC='\033[0m' # No Color
declare -r HEADER_LINE='━'
declare -r CHECK_MARK='✓'
declare -r CROSS_MARK='✗'
declare -r ARROW='→'


# Function to display usage
usage() {
    echo "Usage: $0 [--name base_name] [--instances number_of_instances] [--kill [base_name]]"
    echo "  --name      : Base name for instances (default: fusion)"
    echo "  --instances : Number of instances to create (default: 1)"
    echo "  --kill      : Delete and purge all instances with the specified base name"
    echo "               Can be followed by base name or used with --name"
    echo "  --verbose   : Show detailed status output during setup and verification"
    exit 1
}

# Function to check and enable IP forwarding
check_ip_forwarding() {
    if [[ "$(uname)" == "Darwin" ]]; then  # Check if running on macOS
        if [ $(sysctl -n net.inet.ip.forwarding) -eq 0 ]; then
            echo "Enabling IP forwarding..."
            if ! sudo sysctl -w net.inet.ip.forwarding=1; then
                echo "Failed to enable IP forwarding. Please run script with sudo or enable manually."
                exit 1
            fi
            echo "IP forwarding enabled successfully."
        fi
    fi
}

# Function to handle cleanup when script exits
cleanup() {
    [ "$VERBOSE" = true ] && echo
    [ "$VERBOSE" = true ] && echo "Cleaning up..."
    
    # Clean up temporary cloud-init files
    [ "$VERBOSE" = true ] && echo "Cleaning up temporary cloud-init files..."
    rm -f "$HOST_TEMP_DIR"/fusion-server.yaml 2>/dev/null
    
    # Remove generated cloud config file
    rm fusion-server.yaml 2>/dev/null
}

# Helper functions for formatted output
print_header() {
    local text="$1"
    local width=60
    local padding=$(( (width - ${#text}) / 2 ))
    echo
    printf "%${width}s\n" | sed "s/ /$HEADER_LINE/g"
    printf "%${padding}s${BOLD}%s${NC}%${padding}s\n" "" "$text" ""
    printf "%${width}s\n" | sed "s/ /$HEADER_LINE/g"
}

print_step() {
    printf "${BLUE}${ARROW} ${BOLD}%s${NC}\n" "$1"
}

print_substep() {
    printf "  ${CYAN}${ARROW} %s${NC}\n" "$1"
}

print_success() {
    printf "${GREEN}${CHECK_MARK} %s${NC}\n" "$1"
}

print_error() {
    printf "${RED}${CROSS_MARK} %s${NC}\n" "$1"
}

print_warning() {
    printf "${YELLOW}⚠ %s${NC}\n" "$1"
}

print_progress() {
    local current=$1
    local total=$2
    local text=$3
    local width=50
    local percentage=$((current * 100 / total))
    local progress=$((current * width / total))
    
    printf "\r  ${CYAN}[%-${width}s] %d%% %s${NC}" \
           "$(printf '%0.s█' $(seq 1 $progress))" \
           "$percentage" \
           "$text"
    
    if [ "$current" -eq "$total" ]; then
        echo
    fi
}

show_instance_status() {
    local instance_name="$1"
    
    if [ "$VERBOSE" = true ]; then
        print_header "Instance Status: $instance_name"
        
        print_step "Network Configuration"
        multipass exec "$instance_name" -- networkctl status
        
        print_step "Service Status"
        for service in fusion-server keepalived haproxy; do
            echo
            printf "${CYAN}=== %s ===${NC}\n" "$service"
            multipass exec "$instance_name" -- systemctl status "$service" --no-pager || true
        done
        
        print_step "IP Configuration"
        multipass exec "$instance_name" -- ip addr show

        print_step "Process Status"
        multipass exec "$instance_name" -- ps aux | grep -E 'fusion-server|keepalived|haproxy' || true
    else
        print_header "Basic Status: $instance_name"
        for service in fusion-server keepalived haproxy; do
            status=$(multipass exec "$instance_name" -- systemctl is-active "$service" || echo "inactive")
            if [ "$status" = "active" ]; then
                print_success "$service is running"
            else
                print_error "$service is $status"
            fi
        done
    fi
}

verify_instance() {
    local instance_name="$1"
    local max_retries=30
    local retry_count=0
    
    print_header "Verifying Instance: $instance_name"
    
    print_step "Checking Services"
    while [ $retry_count -lt $max_retries ]; do
        # Check if binary exists
        if ! multipass exec "$instance_name" -- test -x /usr/local/bin/fusion-server; then
            print_progress $retry_count $max_retries "Waiting for fusion-server binary..."
            sleep 5
            ((retry_count++))
            continue
        fi
        
        # Check services one by one
        local all_services_running=true
        for service in fusion-server keepalived haproxy; do
            if ! multipass exec "$instance_name" -- systemctl is-active --quiet "$service"; then
                print_warning "Service $service is not running"
                all_services_running=false
                break
            fi
        done
        
        if [ "$all_services_running" = true ]; then
            print_success "All services are running on $instance_name"
            print_substep "Checking VIP accessibility..."
            
            local response
            response=$(multipass exec "$instance_name" -- curl -sf http://$VIRTUAL_IP:8080 2>/dev/null)
            if [ $? -eq 0 ]; then
                print_success "VIP is accessible"
                printf "${CYAN}Server response: ${NC}%s\n" "$response"
                return 0
            else
                print_warning "VIP is not accessible yet (attempt $((retry_count + 1))/$max_retries)"
            fi
        fi
        
        print_progress $retry_count $max_retries "Waiting for services to start..."
        sleep 5
        ((retry_count++))
    done
    
    print_error "Services failed to start on $instance_name after $max_retries attempts"
    [ "$VERBOSE" = true ] && show_instance_status "$instance_name"
    return 1
}

setup_instance() {
    local instance_name="$1"
    local instance_number="$2"
    
    print_header "Setting Up Instance: $instance_name"
    
    print_step "Initializing instance..."
    sleep 10
    
    print_step "Copying fusion-server binary..."
    if ! multipass transfer "$HOST_BUILD_DIR/fusion-server" "$instance_name":/tmp/; then
        print_error "Failed to copy fusion-server binary"
        return 1
    fi
    print_success "fusion-server copied successfully"
    
    print_step "Installing fusion-server..."
    if ! multipass exec "$instance_name" -- sudo cp /tmp/fusion-server /usr/local/bin/ || \
       ! multipass exec "$instance_name" -- sudo chmod 755 /usr/local/bin/fusion-server || \
       ! multipass exec "$instance_name" -- rm /tmp/fusion-server; then
        print_error "Failed to install fusion-server binary"
        return 1
    fi
    print_success "fusion-server installed successfully"
    
    print_step "Copying bbolt binary..."
    if ! multipass transfer "$HOST_BBOLT_DIR/bbolt-linux-$TARGET_BINARY_ARCH" "$instance_name":/tmp/bbolt; then
        print_error "Failed to copy bbolt binary"
        return 1
    fi
    print_success "bbolt copied successfully"

    print_step "Installing bbolt..."
    if ! multipass exec "$instance_name" -- sudo cp /tmp/bbolt /usr/local/bin/ || \
       ! multipass exec "$instance_name" -- sudo chmod 755 /usr/local/bin/bbolt || \
       ! multipass exec "$instance_name" -- rm /tmp/bbolt; then
        print_error "Failed to install bbolt binary"
        return 1
    fi
    print_success "bbolt installed successfully"

    print_step "Configuring keepalived priority..."
    local priority=$((100 - instance_number))
    multipass exec "$instance_name" -- sudo sed -i "s/priority 100/priority ${priority}/" /etc/keepalived/keepalived.conf
    print_success "Priority set to $priority"
    
    print_step "Starting services..."
    local services_started=true

    # Do daemon-reload once before starting services, with explicit stdin handling
    print_substep "Reloading systemd daemon..."
    if ! multipass exec "$instance_name" -- sudo systemctl daemon-reload </dev/null; then
        print_error "Failed to reload systemd daemon"
        services_started=false
    else
        print_success "Daemon reload completed"
        
        # Now start each service
        for service in fusion-server keepalived haproxy; do
            print_substep "Starting $service..."
            
            # Enable service (without starting)
            if ! multipass exec "$instance_name" -- sudo systemctl enable "$service" </dev/null; then
                print_error "Failed to enable $service"
                services_started=false
                break
            fi
            
            # Start service separately
            if ! multipass exec "$instance_name" -- sudo systemctl start "$service" </dev/null; then
                print_error "Failed to start $service"
                multipass exec "$instance_name" -- sudo systemctl status "$service"
                services_started=false
                break
            fi
            
            # Verify service is actually running
            if ! multipass exec "$instance_name" -- sudo systemctl is-active --quiet "$service" </dev/null; then
                print_error "$service failed to start properly"
                multipass exec "$instance_name" -- sudo systemctl status "$service"
                services_started=false
                break
            fi
            
            print_success "$service started successfully"
        done
    fi

    if [ "$services_started" = false ]; then
        return 1
    fi
    
    [ "$VERBOSE" = true ] && show_instance_status "$instance_name"
    
    return 0
}

launch_instance() {
    local instance_name="$1"
    local instance_number="$2"
    local join_addr="$3"
    local cloud_init_file="$HOST_TEMP_DIR/fusion-server.yaml"

    # Copy to an accesible location. Linux default security for the multipass
    # snap prevents open access to the local filesystem.
    cp fusion-server.yaml "$cloud_init_file"
    
    print_header "Launching Instance: $instance_name"
    
    # Create and launch instance
    print_step "Creating multipass instance..."
    if ! multipass launch --name "$instance_name" --cloud-init "$cloud_init_file" --memory 2G --cpus 2; then
        print_error "Failed to launch instance $instance_name"
        return 1
    fi
    print_success "Instance launched successfully"
    
    # Retrieve the assigned IP address
    local instance_ip
    instance_ip=$(multipass info "$instance_name" | awk '/IPv4/{print $2}')
    
    if [ -z "$instance_ip" ]; then
        print_error "Failed to retrieve IP address for $instance_name"
        return 1
    fi
    
    print_step "Instance IP: $instance_ip"
    
    # Update fusion-server systemd service to use the correct IP
    print_step "Configuring fusion-server service inside instance..."
    multipass exec "$instance_name" -- bash -c "
        sudo sed -i 's|ExecStart=/usr/local/bin/fusion-server.*|ExecStart=/usr/local/bin/fusion-server -name $instance_name -addr $instance_ip -port 7946 ${join_addr:+-join $join_addr} -verbose|' /etc/systemd/system/fusion-server.service
        sudo systemctl daemon-reload
        sudo systemctl restart fusion-server
    "

    print_step "Fusion-server service updated and restarted."

    # Setup the instance
    if ! setup_instance "$instance_name" "$instance_number"; then
        print_error "Failed to setup instance $instance_name"
        return 1
    fi

    # Verify the instance
    if ! verify_instance "$instance_name"; then
        print_error "Failed to verify instance $instance_name"
        return 1
    fi

    print_success "Instance $instance_name is ready"
    return 0
}

to_lower() {
    echo "$1" | tr '[:upper:]' '[:lower:]'
}

prompt_base_name() {
    local default="fusion"
    printf "${YELLOW}Enter base name for instances [${default}]: ${NC}"
    read -r input_base_name
    echo "${input_base_name:-$default}"
}

prompt_num_instances() {
    local default=1
    printf "${YELLOW}Enter number of instances [${default}]: ${NC}"
    read -r input_num
    echo "${input_num:-$default}"
}

prompt_yes_no() {
    local question="$1"
    local default="${2:-n}"  # Default to 'n' if not specified
    
    while true; do
        if [ "$default" = "y" ]; then
            printf "${YELLOW}${question} [Y/n]${NC} "
        else
            printf "${YELLOW}${question} [y/N]${NC} "
        fi
        
        read -r answer
        
        # Default handling
        if [ -z "$answer" ]; then
            answer=$default
        fi
        
        answer=$(to_lower "$answer")
        
        case "$answer" in
            y|yes)
                return 0
                ;;
            n|no)
                return 1
                ;;
            *)
                print_warning "Please answer 'yes' or 'no'"
                ;;
        esac
    done
}

check_existing_instances() {
    local base_name="$1"
    local existing_instances=()
    
    print_step "Checking for existing instances..."
    
    # Get list of existing instances matching base name
    while IFS=, read -r name state ipv4 release; do
        if [[ "$name" == "$base_name"* ]]; then
            existing_instances+=("$name")
        fi
    done < <(multipass list --format csv)
    
    if [ ${#existing_instances[@]} -gt 0 ]; then
        print_warning "Found existing instances:"
        for instance in "${existing_instances[@]}"; do
            local state=$(multipass info "$instance" | grep "State:" | awk '{print $2}')
            printf "  ${CYAN}${ARROW} %s (State: %s)${NC}\n" "$instance" "$state"
        done
        
        if prompt_yes_no "Would you like to delete these instances and continue?"; then
            print_step "Removing existing instances..."
            
            for instance in "${existing_instances[@]}"; do
                print_substep "Deleting instance: $instance"
                if ! multipass delete "$instance"; then
                    print_error "Failed to delete instance: $instance"
                    return 1
                fi
            done
            
            print_substep "Purging deleted instances..."
            if ! multipass purge; then
                print_error "Failed to purge instances"
                return 1
            fi
            
            print_success "Successfully removed existing instances"
            return 0
        else
            print_warning "Aborting due to existing instances"
            exit 1
        fi
    fi
    
    print_success "No existing instances found with base name: $base_name"
    return 0
}

check_platform_arch() {
    # Multipass cannot run a cross-architecture target OS, so we check that the 
    # build/fusion-server symlink points to a platform-compatible binary.
    # This avoids building and running a multipass instance just to find out the fusion-server
    # copied in is not compatible.
    target_arch=$(file -bL build/fusion-server | awk -F ',' '{print $2}' | sed 's/^ //')
    host_arch=$(uname -m)
    TARGET_BINARY_ARCH=$host_arch
    host_os=$(uname | tr '[:upper:]' '[:lower:]')
    host_target_ok=false

    case "$host_arch" in
        'x86'_'64') 
            # x86_64 host can run x86-64 fusion-server.
            [ "$target_arch" = 'x86-64' ] && host_target_ok=true
            TARGET_BINARY_ARCH=amd64
            ;;
        'arm64') 
            # arm64 host can run aarch64 fusion-server in multipass.
            [ "$target_arch" = 'ARM aarch64' ] && host_target_ok=true
            ;;
    esac
    HOST_OS_ARCH="$host_os-$TARGET_BINARY_ARCH"

    if [ "$host_target_ok" = 'false' ]; then
        print_error "CPU architecture mismatch for fusion-server executable: Host=$host_arch, Target=$target_arch"
        return 1
    fi
}

host_setup() {
    # Perform and host configuration necessary to run multipass.
    # Use 'my_multipass_dir' so we don't have to keep checking for unbound MULTIPASS_DIR
    my_multipass_dir="${MULTIPASS_DIR:-}"

    if [ "$VERBOSE" ]; then
        echo "multipass.env environment:"
        echo "      VIRTUAL_IP: '$VIRTUAL_IP'"
        echo "   NET_INTERFACE: '$NET_INTERFACE'"
        echo "   MULTIPASS_DIR: '$my_multipass_dir'"
        echo ""
        echo "HOST_OS_ARCH: '$HOST_OS_ARCH'"
    fi

    if [ -n "$my_multipass_dir" ]; then
        # On a Linux host where 'multipass' is a snap, only the user's home
        # directory is accessible by snaps, so create a directory somewhere under
        # $HOME to use as the 'MULTIPASS_DIR' directory.
        HOST_TEMP_DIR="$my_multipass_dir/tmp"
        HOST_BUILD_DIR="$my_multipass_dir/build"
        HOST_BBOLT_DIR="$my_multipass_dir/tools/bbolt/cmd"
        mkdir -p "$HOST_TEMP_DIR"
        mkdir -p "$HOST_BUILD_DIR"
        mkdir -p "$HOST_BBOLT_DIR"
        # Copy the main binary to HOST_BUILD_DIR
        cp build/fusion-server "$HOST_BUILD_DIR/"
        # Copy the bbolt binary to HOST_BUILD_DIR
        cp "tools/bbolt/cmd/bbolt-linux-$TARGET_BINARY_ARCH" "$HOST_BBOLT_DIR/"
    else
        # Default host paths, works on MacOS.
        HOST_TEMP_DIR=/tmp
        HOST_BUILD_DIR=./build
        HOST_BBOLT_DIR=./tools/bbolt/cmd
    fi
    print_substep "Using HOST_TEMP_DIR=$HOST_TEMP_DIR"
    print_substep "Using HOST_BUILD_DIR=$HOST_BUILD_DIR"
    print_substep "Using HOST_BBOLT_DIR=$HOST_BBOLT_DIR"
}

# Parse command line arguments
VERBOSE=''
while [[ $# -gt 0 ]]; do
    case $1 in
        --name)
            BASE_NAME="$2"
            shift 2
            ;;
        --instances)
            NUM_INSTANCES="$2"
            shift 2
            ;;
        --kill)
            KILL_MODE=true
            # Only check $2 if there is at least one more argument
            if [[ $# -ge 2 && "$2" != --* ]]; then
                KILL_BASE_NAME="$2"
                shift
            else
                echo "Using default base name: fusion."
            fi
            shift
            ;;
        --verbose)
            VERBOSE=true
            shift
            ;;
        *)
            usage
            ;;
    esac
done

# Handle kill mode first
if [ "$KILL_MODE" = true ]; then
    # If no specific kill base name provided, use the general base name
    if [ -z "$KILL_BASE_NAME" ]; then
        KILL_BASE_NAME="${BASE_NAME:-fusion}"
    fi
    print_header "Instance Cleanup"
    print_step "Checking for instances with base name: $KILL_BASE_NAME"
    
    # Get list of matching instances
    instances=()
    while IFS=, read -r name state ipv4 release; do
        if [[ "$name" =~ ^"$KILL_BASE_NAME" ]]; then
            instances+=("$name")
        fi
    done < <(multipass list --format csv)
    
    if [ ${#instances[@]} -eq 0 ]; then
        print_warning "No instances found matching base name: $KILL_BASE_NAME"
        exit 0
    fi

    print_substep "Found ${#instances[@]} instance(s) to remove:"
    for instance in "${instances[@]}"; do
        state=$(multipass info "$instance" | grep "State:" | awk '{print $2}')
        printf "  ${CYAN}${ARROW} %s (State: %s)${NC}\n" "$instance" "$state"
    done
    
    echo
    if ! prompt_yes_no "Are you sure you want to remove these instances?"; then
        print_warning "Operation cancelled by user"
        exit 0
    fi
    
    print_step "Removing instances..."
    for instance in "${instances[@]}"; do
        print_substep "Deleting instance: $instance"
        multipass delete "$instance"
    done
    
    print_step "Purging deleted instances..."
    multipass purge
    print_success "Successfully removed ${#instances[@]} instance(s)"
    exit 0
fi

if [ -z "$NUM_INSTANCES" ]; then
    while true; do
        printf "${YELLOW}Enter number of instances [1]: ${NC}"
        read -r answer
        
        # Default to 1 if empty
        if [ -z "$answer" ]; then
            NUM_INSTANCES=1
            break
        fi
        
        # Validate input is a positive integer
        if [[ "$answer" =~ ^[0-9]+$ ]] && [ "$answer" -gt 0 ]; then
            NUM_INSTANCES=$answer
            break
        else
            print_warning "Please enter a positive number"
        fi
    done
fi

# Prompting for base name
if [ -z "$BASE_NAME" ]; then
    printf "${YELLOW}Enter base name for instances [fusion]: ${NC}"
    read -r input_base_name
    BASE_NAME="${input_base_name:-fusion}"
fi

# If number of instances not specified via arguments, prompt for it
if [ -z "$NUM_INSTANCES" ]; then
    while true; do
        printf "Enter number of instances [1]: "
        read -r answer
        
        # Default to 1 if empty
        if [ -z "$answer" ]; then
            NUM_INSTANCES=1
            break
        fi
        
        # Validate input is a positive integer
        if [[ "$answer" =~ ^[0-9]+$ ]] && [ "$answer" -gt 0 ]; then
            NUM_INSTANCES=$answer
            break
        else
            echo "Please enter a positive number"
        fi
    done
fi

print_step "System checks"

# Note: `check_platform_arch` sets HOST_OS_ARCH and TARGET_BINARY_ARCH
if ! check_platform_arch; then
    exit 1
fi

# Check IP forwarding before proceeding
check_ip_forwarding

host_setup

# Set up trap but don't exit on errors
trap cleanup EXIT

echo
print_header "Starting Cluster Deployment"
echo
print_step "Configuration:"
print_substep "Base name: $BASE_NAME"
print_substep "Number of instances: $NUM_INSTANCES"
echo

if ! check_existing_instances "$BASE_NAME"; then
    exit 1
fi

# Generate base cloud-init
[ "$VERBOSE" = true ] && echo "Generating cloud-init configuration..."
./scripts/generate_cloud_config.sh > fusion-server.yaml

# Launch first instance
FIRST_INSTANCE="${BASE_NAME}1"
if ! launch_instance "$FIRST_INSTANCE" 1 ""; then
    echo "Failed to launch first instance"
    exit 1
fi

# Get the IP of the first instance
FIRST_IP=$(multipass info "$FIRST_INSTANCE" | grep IPv4 | head -1 | awk '{print $2}')
echo "First instance IP: $FIRST_IP"

# Launch additional instances if requested
if [ "$NUM_INSTANCES" -gt 1 ]; then
    for i in $(seq 2 "$NUM_INSTANCES"); do
        INSTANCE_NAME="${BASE_NAME}${i}"
        if ! launch_instance "$INSTANCE_NAME" "$i" "${FIRST_IP}:7946"; then
            echo "Failed to launch instance $INSTANCE_NAME"
            continue
        fi
    done
fi

echo "Cluster deployment complete!"
echo "Created instances with base name '$BASE_NAME':"
(multipass list | awk -v base="$BASE_NAME" '$0 ~ "^"base || $0 ~ /^[[:space:]]+/')


