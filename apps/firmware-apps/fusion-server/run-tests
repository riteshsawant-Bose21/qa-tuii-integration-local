#!/bin/bash

function show_help() {
    echo "Usage: ./run_tests.sh [--all|--controllers|--fusion] [--vip IP:PORT]"
    echo "Options:"
    echo "  --all         Run all tests (default)"
    echo "  --bluetooth   Run only bluetooth tests"
    echo "  --controllers Run only controller tests"
    echo "  --fusion      Run only fusion tests"     
    echo "  --logger      Run only logger tests"     
    echo "  --persistence Run only persistence tests"     
    echo "  --snapshot    Run only snapshot tests"     
    echo "  --state       Run only state manager tests"     
    echo "  --timers      Run only timer tests"     
    echo "  --updater     Run only updater tests"     
    echo "  --vip         VIP address and port (default: 192.168.64.100:8080)"
    exit 1
}

test_type="all"
vip="192.168.64.100:8080"

while [[ $# -gt 0 ]]; do
    case $1 in
        --all)
            test_type="all"
            shift
            ;;
        --bluetooth)
            test_type="bluetooth"
            shift
            ;;
        --controllers)
            test_type="controllers"
            shift
            ;;
        --fusion)
            test_type="fusion"
            shift
            ;;
        --logger)
            test_type="logger"
            shift
            ;;
        --persistence)
            test_type="persistence"
            shift
            ;;
        --snapshot)
            test_type="snapshot"
            shift
            ;;
        --state)
            test_type="state"
            shift
            ;;
        --timers)
            test_type="timers"
            shift
            ;;
        --updater)
            test_type="updater"
            shift
            ;;
        --vip)
            vip="$2"
            shift 2
            ;;
        *)
            show_help
            ;;
    esac
done

sh scripts/clear-config.sh

cd fusion/test || exit 1

case "$test_type" in
    "all")
        go test -v --race  ./... -args --auto --vip "$vip"
        ;;
    "bluetooth")
        go test -v --race ./bluetooth_test.go
        ;;
    "controllers")
        go test -v --race ./cxa_test.go ./cxd_test.go
        ;;
    "fusion")
        go test -v --race ./fusion_test.go -args --auto --vip "$vip"
        ;;
    "logger")
        go test -v --race ./logger_test.go
        ;;
    "persistence")
        go test -v --race ./persistence_test.go
        ;;
    "snapshot")
        go test -v --race ./snapshot_test.go
        ;;
    "state")
        go test -v --race ./state_test.go
        ;;
    "timers")
        go test -v --race ./timers_test.go
        ;;
    "updater")
        go test -v --race ./updater_test.go
        ;;
esac
