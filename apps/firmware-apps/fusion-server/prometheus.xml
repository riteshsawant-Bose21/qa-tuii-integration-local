global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'dsp_servers'
    static_configs:
      - targets: ['172.18.0.3:7946', '172.18.0.4:7946', '172.18.0.5:7946', '172.18.0.6:7946']

  - job_name: 'nginx'
    static_configs:
      - targets: ['172.18.0.7:80', '172.18.0.8:80']
      