#!/bin/bash

function show_help() {
    echo "Usage: ./run_tests.sh [--all|--cluster|--fusion] [--vip IP:PORT]"
    echo "Options:"
    echo "  --vip         VIP address and port (default: 192.168.2.100:8080)"
    echo "  --all         Run all tests (default)"
    echo "  --audio       Run only audio tests"
    echo "  --bluetooth   Run only bluetooth tests"
    echo "  --cluster     Run only cluster tests"
    echo "  --controllers Run only controller tests"
    echo "  --fusion      Run only fusion tests"     
    echo "  --logger      Run only logger tests"     
    echo "  --persistence Run only persistence tests"     
    echo "  --sap         Run only SAP tests"     
    echo "  --snapshot    Run only snapshot tests"     
    echo "  --state       Run only state manager tests"     
    echo "  --tasks       Run only tasks tests"     
    echo "  --udp         Run only UDP tests"     
    echo "  --websocket   Run only websocket tests"     
    exit 1
}

test_type="all"
vip="192.168.2.100:8080"

while [[ $# -gt 0 ]]; do
    case $1 in
        --all)
            test_type="all"
            shift
            ;;
        --audio)
            test_type="audio"
            shift
            ;;
        --bluetooth)
            test_type="bluetooth"
            shift
            ;;
        --cluster)
            test_type="cluster"
            shift
            ;;
        --controllers)
            test_type="controllers"
            shift
            ;;
        --fusion)
            test_type="fusion"
            shift
            ;;
        --logger)
            test_type="logger"
            shift
            ;;
        --persistence)
            test_type="persistence"
            shift
            ;;
        --sap)
            test_type="sap"
            shift
            ;;
        --snapshot)
            test_type="snapshot"
            shift
            ;;
        --state)
            test_type="state"
            shift
            ;;
        --tasks)
            test_type="tasks"
            shift
            ;;
        --udp)
            test_type="udp"
            shift
            ;;
        --updater)
            test_type="updater"
            shift
            ;;
        --websocket)
            test_type="websocket"
            shift
            ;;
        --vip)
            vip="$2"
            shift 2
            ;;
        *)
            show_help
            ;;
    esac
done

curl -X DELETE http://$vip/value
sleep 1 

cd fusion/test || exit 1

case "$test_type" in
    "all")
        test_files=$(ls *_test.go)

        for tf in $test_files; do
            echo "=============================================="
            echo "Running: $tf"
            echo "=============================================="

            # Reset cluster before each test file
            curl -s -X DELETE http://$vip/value > /dev/null
            sleep 1

            go test -v --race "./$tf" -- -auto --vip "$vip"

            echo " "
            sleep 2
        done
        ;;
    "audio")
        go test -v --race ./audio_test.go
        ;;
    "bluetooth")
        go test -v --race ./bluetooth_test.go
        ;;
    "cluster")
        go test -v --race ./cluster_test.go
        ;;
    "controllers")
        go test -v --race ./controllers_test.go
        ;;
    "fusion")
        go test -v --race ./fusion_test.go -args --auto --vip "$vip"
        ;;
    "logger")
        go test -v --race ./logger_test.go
        ;;
    "persistence")
        go test -v --race ./persistence_test.go
        ;;
    "sap")
        go test -v --race ./sap_test.go
        ;;        
    "snapshot")
        go test -v --race ./snapshot_test.go
        ;;
    "state")
        go test -v --race ./state_test.go
        ;;
    "tasks")
        go test -v --race ./tasks_test.go
        ;;
    "udp")
        go test -v --race ./udp_test.go
        ;;
    "websocket")
        go test -v --race ./websocket_test.go
        ;;
esac

cd ../../ || exit 1
curl -X DELETE http://$vip/value

