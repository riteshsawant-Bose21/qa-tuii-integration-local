# function run_simple_test() {
#     local file="$1"
#     if [[ -n "$test_name" ]]; then
#         go test -v --race "$file" -run "$test_name"
#     else
#         go test -v --race "$file"
#     fi
# }

cd fusion/test || exit 1

case "$test_type" in
    "all")
        test_files=$(ls *_test.go)

        for tf in $test_files; do
            echo "=============================================="
            echo "Running: $tf"
            echo "=============================================="

            run_test_file "./$tf"

            echo " "
            sleep 2
        done
        ;;

    certs)        run_test_file ./cluster_certs_test.go ;;
    audio)        run_test_file ./audio_test.go ;;
    bluetooth)    run_test_file ./bluetooth_test.go ;;
    cluster)      run_test_file ./cluster_test.go ;;
    controllers)  run_test_file ./controllers_test.go ;;
    fusion)       run_test_file ./fusion_test.go ;;
    logger)       run_test_file ./logger_test.go ;;
    persistence)  run_test_file ./persistence_test.go ;;
    protobuf)     run_test_file ./protobuf_test.go ;;
    sap)          run_test_file ./sap_test.go ;;
    scheduler)    run_test_file ./scheduler_test.go ;;
    snapshot)     run_test_file ./snapshot_test.go ;;
    software-update) run_test_file ./software_update_test.go ;;
    state)        run_test_file ./state_test.go ;;
    tasks)        run_test_file ./tasks_test.go ;;
    udp)          run_test_file ./udp_test.go ;;
    udp-chaos)
        export FUSION_UDP_CHAOS_TEST=1
        # Run package mode (not single-file mode) so shared TestMain/helpers are available.
        if [[ -n "$test_name" ]]; then
            go test -v --race ./ -run "$test_name" -- -auto --vip "$vip"
        else
            go test -v --race ./ -run "ChaosMesh" -- -auto --vip "$vip"
        fi
        ;;
    websocket)    run_test_file ./websocket_test.go ;;
    integration)
        # Export env for integration helpers
        export FUSION_VIP="${vip%%:*}"
        export FUSION_PORT="${vip##*:}"
        export FUSION_ADMIN_PORT="9090"

        if [ -n "$cluster_size" ]; then
            export FUSION_CLUSTER_SIZE="$cluster_size"
        fi
        # Already inside fusion/test; run integration-tagged tests in ./integration
        if [ ! -d "integration" ]; then
            echo "Integration test directory ./integration not found (expected at fusion/test/integration)" >&2
            exit 1
        fi
        # Disable test result caching to always re-run integration tests
        go test -v --race -count=1 -tags=integration ./integration/...
        ;;
esac

cd ../../ || exit 1
