#!/bin/bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
FUSION_SERVER_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
FUSION_TEST_DIR="$FUSION_SERVER_ROOT/fusion/test"

function essential_test_types() {
    printf '%s\n' \
        "cluster" \
        "health" \
        "fusion" \
        "logger" \
        "persistence" \
        "protobuf" \
        "sap" \
        "scheduler" \
        "state" \
        "time-machine" \
        "version" \
        "websocket"
}

function show_help() {
    echo "Usage: ./run_tests.sh [--all|--cluster|--essential|--fusion|--convergence|--vip-api] [--vip IP:PORT] [--test-name NAME] [--list] [--list-all]"
    echo "Options:"
    echo "  --list              List tests for the selected category"
    echo "  --list-all          List all tests in fusion/test"
    echo "  --profile           Start CPU profiling on all multipass fusion nodes before the run and stop it on exit"
    echo "  --test-name         Run only a specific Go test name or subtest"
    echo "  --vip               VIP address and port passed to multipass/package tests (default: 192.168.2.100:8080)"
    echo "Tests:"
    echo "  --all               Run all tests (default)"
    echo "  --audio             Run only audio tests"
    echo "  --bluetooth         Run only bluetooth tests"
    echo "  --certs             Run only certificate tests (GetCSR, SetDeviceCertificate, ResetDeviceCertificate)"
    echo "  --cluster           Run only cluster tests"
    echo "  --controllers       Run only controller tests"
    echo "  --endpoints         Run only endpoints tests"
    echo "  --essential         Run essential non-disruptive suites"
    echo "  --fusion            Run only fusion tests"     
    echo "  --health            Run only health tests"
    echo "  --integration       Run only integration tests (ex: --integration --size 5) (build tag integration)"
    echo "  --logger            Run only logger tests"     
    echo "  --metadata          Run only metadata tests"
    echo "  --meter-data        Run only meter data tests"
    echo "  --persistence       Run only persistence tests"     
    echo "  --protobuf          Run only protobuf compatibility tests"
    echo "  --sap               Run only SAP tests"     
    echo "  --scheduler         Run only scheduler tests"     
    echo "  --software-update   Run only software update tests"     
    echo "  --state             Run only state manager tests"     
    echo "  --tasks             Run only tasks tests"     
    echo "  --time-machine      Run only time-machine tests"     
    echo "  --udp               Run only UDP tests"     
    echo "  --udp-chaos         Run UDP chaos mesh test (multi-node virtual devices + fault injection)"
    echo "  --udp-latency       Run UDP observer latency diagnostic"
    echo "  --version           Run only version tests"
    echo "  --vip-api           Run VIP REST API tests"
    echo "  --vip-bootstrap     Run VIP bootstrap tests (resets VIP on all nodes)"
    echo "  --vip-convergence   Run VIP/mDNS convergence tests"
    echo "  --websocket         Run only websocket tests"
    exit 1
}

test_type="all"
vip="192.168.2.100:8080"
test_name=""
list_tests=false
list_all_tests=false
cluster_size="3"
enable_profile=false
summary_names=()
summary_codes=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --all)              test_type="all"; shift ;;
        --audio)            test_type="audio"; shift ;;
        --certs)            test_type="certs"; shift ;;
        --bluetooth)        test_type="bluetooth"; shift ;;
        --cluster)          test_type="cluster"; shift ;;        
        --controllers)      test_type="controllers"; shift ;;
        --endpoints)        test_type="endpoints"; shift ;;
        --essential)        test_type="essential"; shift ;;
        --fusion)           test_type="fusion"; shift ;;
        --health)           test_type="health"; shift ;;
        --logger)           test_type="logger"; shift ;;
        --metadata)         test_type="metadata"; shift ;;
        --meter-data)       test_type="meter-data"; shift ;;
        --persistence)      test_type="persistence"; shift ;;
        --protobuf)         test_type="protobuf"; shift ;;
        --sap)              test_type="sap"; shift ;;
        --scheduler)        test_type="scheduler"; shift ;;
        --software-update)  test_type="software-update"; shift ;;
        --state)            test_type="state"; shift ;;
        --tasks)            test_type="tasks"; shift ;;
        --time-machine)     test_type="time-machine"; shift ;;
        --udp)              test_type="udp"; shift ;;
        --udp-latency)      test_type="udp-latency"; shift ;;
        --udp-chaos)        test_type="udp-chaos"; shift ;;
        --version)          test_type="version"; shift ;;
        --vip-api)          test_type="vip-api"; shift ;;       
        --vip-bootstrap)    test_type="vip-bootstrap"; shift ;;        
        --vip-convergence)  test_type="vip-convergence"; shift ;;
        --websocket)        test_type="websocket"; shift ;;
        --integration)      test_type="integration"; shift ;;
        --size)
            if [[ $# -ge 2 && "$2" != --* ]]; then
                cluster_size="$2"
                shift 2
            else
                echo "Error: --size requires a value"
                exit 1
            fi
            ;;
        --vip)
            if [[ $# -ge 2 && "$2" != --* ]]; then
                vip="$2"
                shift 2
            else
                echo "Error: --vip requires a value like 192.168.2.100:8080"
                exit 1
            fi
            ;;
        --test-name)
            if [[ $# -ge 2 && "$2" != --* ]]; then
                test_name="$2"
                shift 2
            else
                echo "Error: --test-name requires a value"
                exit 1
            fi
            ;;
        --list)
            list_tests=true
            shift
            ;;
        --profile)
            enable_profile=true
            shift
            ;;
        --list-all)
            list_all_tests=true
            shift
            ;;
        *)
            show_help
            ;;
    esac
done

export FUSION_TEST_VIP="$vip"
export FUSION_AUTO_DISCOVER=true

function multipass_instances_for_prefix() {
    local prefix="${1:-fusion}"
    multipass list --format csv \
        | tail -n +2 \
        | cut -d',' -f1 \
        | grep "^${prefix}" || true
}

function set_udp_diagnostics_on_instances() {
    local prefix="${1:-fusion}"
    local instances
    instances=$(multipass_instances_for_prefix "$prefix")
    if [[ -z "$instances" ]]; then
        echo "No multipass instances found with prefix '$prefix' to enable UDP diagnostics" >&2
        return 1
    fi

    echo "Enabling UDP diagnostics on instances with prefix '$prefix'..."
    for instance in $instances; do
        echo "  -> $instance"
        multipass exec "$instance" -- sudo bash -lc '
            set -euo pipefail
            systemctl set-environment FUSION_UDP_DIAGNOSTICS=1
            systemctl restart fusion-server
        '
    done
}

function clear_udp_diagnostics_on_instances() {
    local prefix="${1:-fusion}"
    local instances
    instances=$(multipass_instances_for_prefix "$prefix")
    if [[ -z "$instances" ]]; then
        return 0
    fi

    echo "Disabling UDP diagnostics on instances with prefix '$prefix'..."
    for instance in $instances; do
        echo "  -> $instance"
        multipass exec "$instance" -- sudo bash -lc '
            set -euo pipefail
            systemctl unset-environment FUSION_UDP_DIAGNOSTICS || true
            systemctl restart fusion-server
        '
    done
}

function start_cpu_profile_on_instances() {
    local prefix="${1:-fusion}"
    local instances
    instances=$(multipass_instances_for_prefix "$prefix")
    if [[ -z "$instances" ]]; then
        echo "No multipass instances found with prefix '$prefix' to enable profiling" >&2
        return 1
    fi

    echo "Starting CPU profiling on instances with prefix '$prefix'..."
    for instance in $instances; do
        echo "  -> $instance"
        multipass exec "$instance" -- bash -lc '
            set -euo pipefail
            curl -sfS -X POST http://127.0.0.1:9090/debug/profile/start
        '
    done
}

function stop_cpu_profile_on_instances() {
    local prefix="${1:-fusion}"
    local instances
    instances=$(multipass_instances_for_prefix "$prefix")
    if [[ -z "$instances" ]]; then
        return 0
    fi

    echo "Stopping CPU profiling on instances with prefix '$prefix'..."
    for instance in $instances; do
        echo "  -> $instance"
        multipass exec "$instance" -- bash -lc '
            set -euo pipefail
            curl -sfS -X POST http://127.0.0.1:9090/debug/profile/stop || true
        '
    done
}

function first_multipass_instance_ip() {
    local prefix="${1:-fusion}"
    local first
    first=$(multipass list --format csv \
        | tail -n +2 \
        | awk -F',' -v prefix="$prefix" '$1 ~ ("^" prefix) { print $3; exit }')
    printf '%s' "$first"
}

if [[ "$enable_profile" = true ]]; then
    trap 'stop_cpu_profile_on_instances "fusion"' EXIT
    start_cpu_profile_on_instances "fusion"
fi

# Helper to list tests from a file
function list_tests_from_file() {
    local file="$1"
    echo "Tests in $file:"
    rg -o '^func (Test[^(: ]+)' "$file" -r '$1' | sort
    echo ""
}

function list_tests_from_dir() {
    local dir="$1"
    echo "Tests in $dir:"
    rg -o --no-filename '^func (Test[^(: ]+)' "$dir"/*.go -r '$1' | sort
    echo ""
}

# List all tests across the directory
function list_all() {
    echo "Listing all tests under fusion/test:"
    for f in *_test.go; do
        list_tests_from_file "./$f"
    done
    exit 0
}

# Determine the file for a given category
function test_file_for_type() {
    case "${1:-$test_type}" in
        audio)                  echo "audio_test.go" ;;
        bluetooth)              echo "bluetooth_test.go" ;;
        certs)                  echo "cluster_certs_test.go" ;;
        cluster)                echo "cluster_test.go, reboot_test.go" ;;
        controllers)            echo "controllers_test.go" ;;
        endpoints)              echo "endpoints_test.go" ;;
        fusion)                 echo "fusion_test.go" ;;
        health)                 echo "health_test.go" ;;
        logger)                 echo "logger_test.go" ;;
        metadata)               echo "metadata_test.go" ;;
        meter-data)             echo "meter_data_test.go" ;;
        persistence)            echo "persistence_test.go" ;;
        protobuf)               echo "protobuf_test.go" ;;
        sap)                    echo "sap_test.go" ;;
        scheduler)              echo "scheduler_test.go" ;;
        software-update)        echo "software_update_test.go" ;;
        time-machine)           echo "time_machine_test.go" ;;
        state)                  echo "state_test.go" ;;
        tasks)                  echo "tasks_test.go" ;;
        udp)                    echo "udp_test.go" ;;
        udp-observer-latency)   echo "udp_observer_latency_test.go" ;;
        udp-latency)            echo "udp_observer_latency_test.go" ;;
        udp-chaos)              echo "udp_chaos_test.go" ;;
        version)                echo "version_test.go" ;;
        vip-api)                echo "vip_endpoints_test.go" ;;
        vip-bootstrap)          echo "bootstrap_vip_test.go" ;;
        vip-convergence)        echo "setup_vip_test.go" ;;
        websocket)              echo "websocket_test.go" ;;
        integration)            echo "integration tests" ;;
        all)    
    esac
}

function list_named_test_type() {
    local named_type="$1"
    local file

    if [[ "$named_type" == "all" ]]; then
        echo "Use --list-all for all test files."
        return 0
    fi

    file=$(test_file_for_type "$named_type")
    if [[ -z "$file" ]]; then
        echo "No file found for test type '$named_type'"
        return 1
    fi

    if [[ "$named_type" == "logger" ]]; then
        list_tests_from_file "./$file"
        echo "Tests in ../../fusion-services-core/logging:"
        (cd ../../../fusion-services-core/logging && for f in *_test.go; do
            echo "Tests in ./logging/$f:"
            rg -o '^func (Test[^(: ]+)' "$f" -r '$1' | sort
            echo ""
        done)
        echo ""
        return 0
    fi

    if [[ "$named_type" == "udp-chaos" ]]; then
        echo "Tests in package ./ matching UDP chaos:"
        rg -o '^func (Test[^(: ]+)' ./*_test.go -r '$1' | grep 'Chaos\|UDP' | sort
        echo ""
        return 0
    fi

    if [[ "$named_type" == "essential" ]]; then
        local essential_type
        echo "Tests in essential categories:"
        while IFS= read -r essential_type; do
            list_named_test_type "$essential_type" || return 1
        done < <(essential_test_types)
        return 0
    fi

    if [[ "$named_type" == "tasks" ]]; then
        list_tests_from_file "./tasks_test.go"
        list_tests_from_dir "./tasks"
        return 0
    fi

    if [[ "$named_type" == "persistence" ]]; then
        list_tests_from_dir "./persistence"
        return 0
    fi

    list_tests_from_file "./$file"
}

# Handle list-all
if [[ "$list_all_tests" = true ]]; then
    cd fusion/test || exit 1
    list_all
fi

# Handle list for a specific category
if [[ "$list_tests" = true ]]; then
    cd fusion/test || exit 1
    list_named_test_type "$test_type"
    exit 0
fi

# Build a -run regex from top-level Test* functions declared in a file.
function regex_for_test_file() {
    local file="$1"
    local tests
    tests=$(rg -o --no-filename '^func (Test[^(: ]+)' "$file" -r '$1' | paste -sd'|' -)
    if [[ -z "$tests" ]]; then
        return 1
    fi
    printf '^(%s)$' "$tests"
}

function list_test_names_for_glob() {
    local glob="$1"
    rg -o --no-filename '^func (Test[^(: ]+)' $glob -r '$1' 2>/dev/null | sort -u
}

function list_test_names_for_type() {
    local label="$1"

    case "$label" in
        all)
            {
                list_test_names_for_glob "./*_test.go"
                list_test_names_for_glob "./tasks/*_test.go"
                list_test_names_for_glob "./persistence/*_test.go"
            } | sort -u
            ;;
        logger)
            {
                list_test_names_for_glob "./logger_test.go"
                (cd ../../../fusion-services-core/logging && list_test_names_for_glob "./*_test.go")
            } | sort -u
            ;;
        tasks)
            {
                list_test_names_for_glob "./tasks_test.go"
                list_test_names_for_glob "./tasks/*_test.go"
            } | sort -u
            ;;
        persistence)
            list_test_names_for_glob "./persistence/*_test.go"
            ;;
        integration)
            list_test_names_for_glob "./integration/*_test.go"
            ;;
        udp-chaos)
            list_test_names_for_glob "./udp_chaos_test.go"
            ;;
        essential)
            local essential_type
            while IFS= read -r essential_type; do
                list_test_names_for_type "$essential_type"
            done < <(essential_test_types)
            ;;
        *)
            local file
            file=$(test_file_for_type "$label")
            if [[ -n "$file" ]]; then
                list_test_names_for_glob "./$file"
            fi
            ;;
    esac
}

function ensure_test_name_matches() {
    local label="$1"
    if [[ -z "$test_name" ]]; then
        return 0
    fi

    local matches
    matches=$(list_test_names_for_type "$label" | grep -E "$test_name" || true)
    if [[ -n "$matches" ]]; then
        return 0
    fi

    echo "No tests matched --test-name '$test_name' for test type '$label'" >&2
    echo "Use --list or --list-all to inspect available test names." >&2
    return 1
}

# Helper to run fusion/test in package mode so shared TestMain/helpers are available.
function filter_go_test_output() {
    awk '
        /^[[:space:]]*=== RUN/ {
            sub(/^[[:space:]]*=== RUN[[:space:]]+/, "")
            print $0
            next
        }
        /^[[:space:]]*--- PASS:/ { next }
        /^[[:space:]]*PASS$/ { next }
        /^[[:space:]]*ok[[:space:]]+/ { next }
        { print }
    '
}

function run_go_test_filtered() {
    "$@" 2>&1 | filter_go_test_output
    return "${PIPESTATUS[0]}"
}

function run_package_tests() {
    local run_regex="${1:-}"

    echo ""

    if [[ -n "$test_name" ]]; then
        run_go_test_filtered go test -v --race . -run "$test_name" -args -auto -vip "$vip"
    elif [[ -n "$run_regex" ]]; then
        run_go_test_filtered go test -v --race . -run "$run_regex" -args -auto -vip "$vip"
    else
        run_go_test_filtered go test -v --race . -args -auto -vip "$vip"
    fi
}

function run_subpackage_tests() {
    local pkg="$1"

    echo ""

    if [[ -n "$test_name" ]]; then
        run_go_test_filtered go test -v --race "$pkg" -run "$test_name"
    else
        run_go_test_filtered go test -v --race "$pkg"
    fi
}

function run_tasks_tests() {
    local status=0

    echo ""
    echo "=============================================="
    echo "Running package: ./fusion/test"
    echo "Tasks file: ./tasks_test.go"
    echo "VIP: $vip"
    echo "=============================================="
    run_package_tests "$(regex_for_test_file ./tasks_test.go)" || status=$?

    echo ""
    echo "=============================================="
    echo "Running package: ./fusion/test/tasks"
    echo "=============================================="
    run_subpackage_tests "./tasks" || status=$?

    return "$status"
}

function run_logger_tests() {
    local status=0

    echo ""
    echo "=============================================="
    echo "Running package: ./fusion/test"
    echo "Logger tests: fusion/test/logger_test.go"
    echo "=============================================="
    run_package_tests "$(regex_for_test_file ./logger_test.go)" || status=$?

    echo ""
    echo "=============================================="
    echo "Running package: ../../fusion-services-core/logging"
    echo "=============================================="
    (cd ../../../fusion-services-core && go test -v --race ./logging) || status=$?

    return "$status"
}

function print_group_header() {
    local label="$1"
    echo ""
    echo "=============================================="
    echo "Running $label tests"
    echo "=============================================="
}

function run_essential_tests() {
    local status=0
    local essential_type
    while IFS= read -r essential_type; do
        run_named_test_type "$essential_type" || status=$?
    done < <(essential_test_types)

    return "$status"
}

function record_summary_result() {
    local label="$1"
    local code="$2"
    if [[ "$label" == "essential" ]]; then
        return
    fi
    summary_names+=("$label")
    summary_codes+=("$code")
}

function print_summary() {
    local count="${#summary_names[@]}"
    if [[ "$count" -eq 0 ]]; then
        return
    fi

    local i
    local failed=0

    echo ""
    echo "=============================================="
    echo "Summary"
    echo "=============================================="

    for ((i=0; i<count; i++)); do
        if [[ "${summary_codes[$i]}" -eq 0 ]]; then
            echo "PASS  ${summary_names[$i]}"
        else
            echo "FAIL  ${summary_names[$i]}"
            failed=1
        fi
    done

    return "$failed"
}

function run_named_test_type() {
    local label="$1"
    local status=0

    ensure_test_name_matches "$label" || return 1

    case "$label" in
        "all")
            echo ""
            echo "=============================================="
            echo "Running package: ./fusion/test"
            echo "VIP: $vip"
            echo "=============================================="
            run_package_tests || status=$?
            ;;

        audio)              print_group_header "audio"; run_package_tests "$(regex_for_test_file ./audio_test.go)" || status=$? ;;
        bluetooth)          print_group_header "bluetooth"; run_package_tests "$(regex_for_test_file ./bluetooth_test.go)" || status=$? ;;
        certs)              print_group_header "certs"; run_package_tests "$(regex_for_test_file ./cluster_certs_test.go)" || status=$? ;;
        cluster)            print_group_header "cluster"; run_package_tests "$(regex_for_test_file ./cluster_test.go)" || status=$? ;;
        essential)          run_essential_tests || status=$? ;;
        controllers)        print_group_header "controllers"; run_package_tests "$(regex_for_test_file ./controllers_test.go)" || status=$? ;;
        endpoints)          print_group_header "endpoints"; run_package_tests "$(regex_for_test_file ./endpoints_test.go)" || status=$? ;;
        fusion)             print_group_header "fusion"; run_package_tests "$(regex_for_test_file ./fusion_test.go)" || status=$? ;;
        health)             print_group_header "health"; run_package_tests "$(regex_for_test_file ./health_test.go)" || status=$? ;;
        logger)             run_logger_tests || status=$? ;;
        metadata)           print_group_header "metadata"; run_package_tests "$(regex_for_test_file ./metadata_test.go)" || status=$? ;;
        meter-data)         print_group_header "meter-data"; run_package_tests "$(regex_for_test_file ./meter_data_test.go)" || status=$? ;;
        persistence)
            print_group_header "persistence"
            run_subpackage_tests "./persistence" || status=$?
            ;;
        protobuf)           print_group_header "protobuf"; run_package_tests "$(regex_for_test_file ./protobuf_test.go)" || status=$? ;;
        sap)                print_group_header "sap"; run_package_tests "$(regex_for_test_file ./sap_test.go)" || status=$? ;;
        scheduler)          print_group_header "scheduler"; run_package_tests "$(regex_for_test_file ./scheduler_test.go)" || status=$? ;;
        software-update)    print_group_header "software-update"; run_package_tests "$(regex_for_test_file ./software_update_test.go)" || status=$? ;;
        time-machine)
            print_group_header "time-machine"
            run_package_tests "$(regex_for_test_file ./time_machine_test.go)" || status=$?
            ;;
        state)              print_group_header "state"; run_package_tests "$(regex_for_test_file ./state_test.go)" || status=$? ;;
        tasks)              run_tasks_tests || status=$? ;;
        udp)
            print_group_header "udp"
            if [[ -z "${FUSION_UDP_ADDR:-}" ]]; then
                unset FUSION_UDP_LOCAL
                udp_ip="$(first_multipass_instance_ip "fusion")"
                if [[ -z "$udp_ip" ]]; then
                    echo "Unable to determine UDP target IP from multipass instances" >&2
                    return 1
                fi
                export FUSION_UDP_ADDR="${udp_ip}:7947"
            fi
            run_package_tests "$(regex_for_test_file ./udp_test.go)" || status=$?
            ;;

        vip-api)      print_group_header "vip-api"; run_package_tests "$(regex_for_test_file ./vip_endpoints_test.go)" || status=$? ;;
        vip-bootstrap)   print_group_header "vip-bootstrap"; run_package_tests "$(regex_for_test_file ./bootstrap_vip_test.go)" || status=$? ;;
        vip-convergence) print_group_header "vip-convergence"; run_package_tests "$(regex_for_test_file ./setup_vip_test.go)" || status=$? ;;
        udp-chaos)
            print_group_header "udp-chaos"
            export FUSION_UDP_CHAOS_TEST=1
            if [[ -n "$test_name" ]]; then
                go test -v --race . -run "$test_name" -args -auto -vip "$vip" || status=$?
            else
                go test -v --race . -run "ChaosMesh" -args -auto -vip "$vip" || status=$?
            fi
            ;;
        udp-latency)
            if [[ "$enable_profile" = true ]]; then
                trap 'clear_udp_diagnostics_on_instances "fusion"; stop_cpu_profile_on_instances "fusion"' EXIT
            else
                trap 'clear_udp_diagnostics_on_instances "fusion"' EXIT
            fi
            set_udp_diagnostics_on_instances "fusion"
            export FUSION_UDP_OBSERVER_LATENCY_TEST=1
            run_package_tests "$(regex_for_test_file ./udp_observer_latency_test.go)" || status=$?
            ;;
        version)      print_group_header "version"; run_package_tests "$(regex_for_test_file ./version_test.go)" || status=$? ;;
        websocket)    print_group_header "websocket"; run_package_tests "$(regex_for_test_file ./websocket_test.go)" || status=$? ;;
        integration)
            print_group_header "integration"
            export FUSION_VIP="${vip%%:*}"
            export FUSION_PORT="${vip##*:}"
            export FUSION_ADMIN_PORT="9090"

            if [ -n "$cluster_size" ]; then
                export FUSION_CLUSTER_SIZE="$cluster_size"
            fi

            if [ ! -d "./integration" ]; then
                echo "Integration test directory ./integration not found (expected at fusion/test/integration)" >&2
                return 1
            fi

            go test -v --race -count=1 -tags=integration ./integration/... || status=$?
            ;;
        *)
            echo "Unknown test type: $label" >&2
            return 1
            ;;
    esac

    record_summary_result "$label" "$status"
    return "$status"
}

cd "$FUSION_TEST_DIR" || exit 1

run_named_test_type "$test_type"
overall_status=$?
print_summary
summary_status=$?

cd "$FUSION_SERVER_ROOT" || exit 1
if [[ "$overall_status" -ne 0 ]]; then
    exit "$overall_status"
fi
exit "$summary_status"
