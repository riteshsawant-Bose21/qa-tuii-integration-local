{
    "session": {
        "name": "fusion_system_monitor"
    },
    "periodic_tasks": [
        {
            "name": "system_info",
            "property_settings": [
                { "name": "period_ms", "value": 2000 }
            ],
            "blocks": [
                {
                    "name": "system_info",
                    "module": "system_info",
                    "telemetry": [
                        { "name": "cpu" },
                        { "name": "high_cpu_usage" },
                        { "name": "ram" },
                        { "name": "high_ram_usage" },
                        { "name": "emmc" },
                        { "name": "high_emmc_usage" },
                        { "name": "usb_storage" },
                        { "name": "usb_connected" },
                        { "name": "temperature" }
                    ]
                }
            ]
        },
        {
            "name": "hw_control",
            "blocks": [
                {
                    "name": "hw_control",
                    "module": "hw_control",
                    "property_settings": [
                        { 
                            "name": "num_php_chs",
                            "value": 1
                        },
                        { 
                            "name": "php_paths",
                            "value": [
                                "xlr-pal/gpio_PWR_SW1"
                            ]
                        },
                        {
                            "name": "php_led",
                            "value": "PWM4"
                        }
                    ]
                }
            ]
        },
        {
            "name": "fusion_connect",
            "property_settings": [
                { "name": "period_ms", "value": 500 }
            ],
            "blocks": [
                {
                    "name": "fusion_connect_client",
                    "module": "fusion_connect_client",
                    "property_settings": [
                        { "name": "period_ms", "value": 500 },
                        { "name": "enet_iface", "value": "lan1" }
                    ],
                    "parameters": [
                        { "name": "audio_streams_update" }
                    ]
                }
            ]
        }
    ]
}
