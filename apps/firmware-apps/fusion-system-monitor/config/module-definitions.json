{
    "modules": [
        {
            "name": "cpu_usage",
            "telemetry": [
                { 
                    "name": "cpu", 
                    "value_type": "float", 
                    "minimum_value": 0.0,
                    "maximum_value": 100.0,
                    "telemetry_type": "meter",
                    "period_type": "LO" 
                },
                { 
                    "name": "high_cpu_usage", 
                    "value_type": "bool", 
                    "telemetry_type": "event",
                    "period_type": "N/A"
                }
            ]
        },
        {
            "name": "space_usage",
            "telemetry": [
                { 
                    "name": "ram", 
                    "value_type": "float", 
                    "minimum_value": 0.0,
                    "maximum_value": 100.0,
                    "telemetry_type": "meter",
                    "period_type": "MED" 
                },
                { 
                    "name": "high_ram_usage", 
                    "value_type": "bool", 
                    "telemetry_type": "event",
                    "period_type": "N/A"
                },
                { 
                    "name": "emmc", 
                    "value_type": "float", 
                    "minimum_value": 0.0,
                    "maximum_value": 100.0,
                    "telemetry_type": "meter",
                    "period_type": "MED"  
                },
                { 
                    "name": "high_emmc_usage", 
                    "value_type": "bool", 
                    "telemetry_type": "event",
                    "period_type": "N/A"
                },
                { 
                    "name": "usb_storage", 
                    "value_type": "float", 
                    "minimum_value": 0.0,
                    "maximum_value": 100.0,
                    "telemetry_type": "meter",
                    "period_type": "MED"  
                },
                { 
                    "name": "usb_connected", 
                    "value_type": "bool", 
                    "telemetry_type": "event",
                    "period_type": "N/A"
                }
            ]
        },
        {
