                                "fm8y/block_gpio/gpio_ctrl0_gpio1",
                                "fm8y/block_gpio/gpio_ctrl0_gpio2",
                                "fm8y/block_gpio/gpio_ctrl0_gpio3",
                                "fm8y/block_gpio/gpio_ctrl0_gpio4"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "name": "fusion_connect",
            "property_settings": [
                { "name": "period_ms", "value": 500 }
            ],
            "blocks": [
                {
                    "name": "fusion_connect_client",
                    "module": "fusion_connect_client",
                    "property_settings": [
                        { "name": "period_ms", "value": 500 },
                        { "name": "enet_iface", "value": "lan1" }
                    ],
                    "parameters": [
                        { "name": "audio_streams_update" }
