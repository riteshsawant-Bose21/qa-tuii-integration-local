{
    "session": {
        "name": "fusion_system_monitor"
    },
    "periodic_tasks": [
        {
            "name": "fw_monitor",
            "property_settings": [
                { "name": "period_ms", "value": 2000 }
            ],
            "blocks": [
                {
                    "name": "cpu_usage",
                    "module": "cpu_usage",
                    "telemetry": [
                        { "name": "cpu" },
                        { "name": "high_cpu_usage" }
                    ]
                },
                {
                    "name": "space_usage",
                    "module": "space_usage",
                    "telemetry": [
                        { "name": "ram" },
                        { "name": "high_ram_usage" },
                        { "name": "emmc" },
                        { "name": "high_emmc_usage" },
                        { "name": "usb_storage" },
                        { "name": "usb_connected" }
                    ]
                }
            ]
        },
        {
            "name": "bt_control",
            "property_settings": [
                { "name": "period_ms", "value": 200 }
            ],
            "blocks": [
                {
                    "name": "bt_control",
                    "module": "bt_control"
                }
            ]
        },
        {
            "name": "hw_control",
            "blocks": [
                {
                    "name": "hw_control",
                    "module": "hw_control",
                    "property_settings": [
                        { 
                            "name": "num_gain_chs",
