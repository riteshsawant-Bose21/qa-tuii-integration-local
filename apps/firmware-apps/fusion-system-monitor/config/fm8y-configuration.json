                            "value": [
                                "fm8y/block_ana/ep_aud_in_chs-34/gpio_gain_ch3_0",
                                "fm8y/block_ana/ep_aud_in_chs-34/gpio_gain_ch4_0",
                                "fm8y/block_ana/ep_aud_in_chs-56/gpio_gain_ch5_0",
                                "fm8y/block_ana/ep_aud_in_chs-56/gpio_gain_ch6_0"
                            ]
                        },
                        { 
                            "name": "num_php_chs",
                            "value": 4
                        },
                        { 
                            "name": "php_paths",
                            "value": [
                                "fm8y/block_ana/ep_aud_in_chs-34/gpio_php_en_ch3",
                                "fm8y/block_ana/ep_aud_in_chs-34/gpio_php_en_ch4",
                                "fm8y/block_ana/ep_aud_in_chs-56/gpio_php_en_ch5",
                                "fm8y/block_ana/ep_aud_in_chs-56/gpio_php_en_ch6"
                            ]
