# Ignore build artifacts across the project

# Compiled object files
*.o

# Static and shared libraries
*.a
*.so
*.dylib

# Executable targets (OCALite and controller)
/app/OCALite/ocalite
/app/OCALiteController/ocalitecontroller

# Common library build
/common/libocalitecommon.a

# Backup and temp files
*~
*.swp
*.tmp

# macOS system files
.DS_Store

# Visual Studio Code settings
.vscode/
