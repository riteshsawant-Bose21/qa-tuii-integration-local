{
    "session": {
        "property_settings": [
            { "name": "frame_size", "value": 32},
            { "name": "sample_rate", "value": 48000 }
        ]
    },
    "audio_tasks": [
        {
            "name": "task1",
            "property_settings": [
                { "name": "is_jack_client", "value": false },
                { "name": "frame_size", "value": 32},
                { "name": "sample_rate", "value": 48000 }
            ],
            "blocks": [
                {
                    "name": "infile",
                    "algorithm": "wav_read",
                    "property_settings": [
                        { "name": "frame_size", "value": 32},
                        { "name": "sample_rate", "value": 48000 },
                        { "name": "filename", "value": "in.wav" }
                    ],
                    "terminal_channels": [
                        { "name": "out", "channels": 1 }
                    ]
                },
                {
                    "name": "loudspeaker_processor",
                    "algorithm": "loudspeaker_processor_dm5se",
                    "property_settings": [
                        { "name": "frame_size", "value": 32 },
                        { "name": "sample_rate", "value": 48000 }
                    ]
                },
                {
                    "name": "outfile",
                    "algorithm": "wav_write",
                    "property_settings": [
                        { "name": "frame_size", "value": 32 },
                        { "name": "sample_rate", "value": 48000 },
                        { "name": "filename", "value": "out.wav" }
                    ],
                    "terminal_channels": [
                        { "name": "in", "channels": 1 }
                    ]
                }
            ],
            "block_connections": [
                {
                    "source_block": "infile",
                    "output_terminal": "out",
                    "output_channel": 1,
                    "destination_block": "loudspeaker_processor",
                    "input_terminal": "in",
                    "input_channel": 1
                },
                {
                    "source_block": "loudspeaker_processor",
                    "output_terminal": "out",
                    "output_channel": 1,
                    "destination_block": "outfile",
                    "input_terminal": "in",
                    "input_channel": 1
                }
            ]
        }
    ],
    "parameter_settings": [
        {
            "target": "loudspeaker_processor",
            "name": "peak_threshold",
            "value": -30.0
        },
        {
            "target": "loudspeaker_processor",
            "name": "rms_threshold",
            "value": -36.0
        }
    ]
}
