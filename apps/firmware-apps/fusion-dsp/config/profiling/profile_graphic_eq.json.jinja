{
    "session": {
        "property_settings": [
            { "name": "frame_size", "value": 32},
            { "name": "sample_rate", "value": 48000 }
        ]
    },
    "audio_tasks": [
        {
            "name": "task1",
            "property_settings": [
                { "name": "is_jack_client", "value": false },
                { "name": "frame_size", "value": 32},
                { "name": "sample_rate", "value": 48000 },
                { "name": "timing_log_file", "value": "{{ output_file }}" },
                { "name": "profile_blocks", "value" : true }
            ],
            "blocks": [
                {
                    "name": "infile",
                    "algorithm": "wav_read",
                    "property_settings": [
                        { "name": "frame_size", "value": 32 },
                        { "name": "sample_rate", "value": 48000 },
                        { "name": "filename", "value": "in.wav"}
                    ],
                    "terminal_channels": [
                        { "name": "out", "channels": 1 }
                    ]
                },
                {
                    "name": "graphic_eq",
                    "algorithm": "graphic_eq",
                    "property_settings": [
                        { "name": "channels", "value": {{ channels }} },
                        { "name": "frame_size", "value": 32 },
                        { "name": "sample_rate", "value": 48000 }
                    ]
                },
                {
                    "name": "outfile",
                    "algorithm": "wav_write",
                    "property_settings": [
                        { "name": "frame_size", "value": 32 },
                        { "name": "sample_rate", "value": 48000 }
                    ],
                    "terminal_channels": [
                        { "name": "in", "channels": {{ channels }} }
                    ]
                }
            ],
            "block_connections": [
                {% for channel in range(1,channels+1) %}

                {
                  "source_block": "infile",
                  "output_terminal": "out",
                  "output_channel": 1,
                  "destination_block": "graphic_eq",
                  "input_terminal": "in",
                  "input_channel": {{ channel }}
              },
              {
                  "source_block": "graphic_eq",
                  "output_terminal": "out",
                  "output_channel": {{ channel }},
                  "destination_block" : "outfile",
                  "input_terminal": "in",
                  "input_channel": {{ channel }}
              }{{ "," if not loop.last else "" }}
              {% endfor %}
            ]
        }
      
    ],
    "parameter_settings": [
        {
            "target": "graphic_eq",
            "name": "gain",
            "index": [10],
            "value": -15.0
        },
        {
            "target": "graphic_eq",
            "name": "gain",
            "index": [1],
            "value": -15.0
        },
        {
            "target": "graphic_eq",
            "name": "gain",
            "index": [5],
            "value": -15.0
        }
    ]
}
