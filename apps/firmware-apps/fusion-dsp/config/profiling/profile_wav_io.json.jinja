{
    "session": {
        "property_settings": [
            { "name": "frame_size", "value": 32},
            { "name": "sample_rate", "value": 48000 }
        ]
    },
    "audio_tasks": [
        {
            "name": "task1",
            "property_settings": [
                { "name": "is_jack_client", "value": false },
                { "name": "frame_size", "value": 32},
                { "name": "sample_rate", "value": 48000 },
                { "name": "timing_log_file", "value": "{{ output_file }}"},
                { "name": "profile_blocks", "value": true}
            ],
            "blocks": [
                {
                    "name": "wav_read",
                    "algorithm": "wav_read",
                    "property_settings": [
                        { "name": "frame_size", "value": 32},
                        { "name": "sample_rate", "value": 48000 },
                        { "name": "filename", "value" : "{{ wav_input }}"}
                    ],
                    "terminal_channels": [
                        { "name": "out", "channels": 1 }
                    ]
                },
                {
                    "name": "wav_write",
                    "algorithm": "wav_write",
                    "property_settings": [
                        { "name": "frame_size", "value": 32 },
                        { "name": "sample_rate", "value": 48000 },
                        { "name": "filename", "value": "out.wav"}
                    ],
                    "terminal_channels": [
                        { "name": "in", "channels": 1 }
                    ]
                }
            ],
            "block_connections": [
                {
                    "source_block": "wav_read",
                    "output_terminal": "out",
                    "output_channel": 1,
                    "destination_block": "wav_write",
                    "input_terminal": "in",
                    "input_channel": 1
                }
            ]
        }
    ]
}