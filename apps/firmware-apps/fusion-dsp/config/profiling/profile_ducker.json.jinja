{
    "session": {
        "property_settings": [
            { "name": "frame_size", "value": 32},
            { "name": "sample_rate", "value": 48000 }
        ]
    },
    "audio_tasks": [
        {
            "name": "task1",
            "property_settings": [
                { "name": "is_jack_client", "value": false },
                { "name": "frame_size", "value": 32},
                { "name": "sample_rate", "value": 48000 },
                { "name": "timing_log_file", "value": "{{ output_file }}"},
                { "name": "profile_blocks", "value": true}

            ],
            "blocks": [
                {
                    "name": "infile",
                    "algorithm": "wav_read",
                    "property_settings": [
                        { "name": "frame_size", "value": 32},
                        { "name": "sample_rate", "value": 48000 },
                        { "name": "filename", "value": "{{ wav_input }}"}                  ],
                    "terminal_channels": [
                        { "name": "out", "channels": 2 }
                    ]
                },
                {
                    "name": "ducker",
                    "algorithm": "ducker",
                    "property_settings": [
                        { "name": "channels", "value": {{ channels }} },
                        { "name": "frame_size", "value": 32 },
                        { "name": "sample_rate", "value": 48000 }
                    ]
                },
                {
                    "name": "outfile",
                    "algorithm": "wav_write",
                    "property_settings": [
                        { "name": "frame_size", "value": 32 },
                        { "name": "sample_rate", "value": 48000 }
                    ],
                    "terminal_channels": [
                        { "name": "in", "channels": {{ channels }} }
                    ]
                }
            ],
            "block_connections": [
                {% for channel in range(1, channels+1) %}
                {
                    "source_block": "infile",
                    "output_terminal": "out",
                    "output_channel": 1,
                    "destination_block": "ducker",
                    "input_terminal": "in",
                    "input_channel": {{ channel }}
                },
                {
                    "source_block": "ducker",
                    "output_terminal": "out",
                    "output_channel": {{ channel }},
                    "destination_block": "outfile",
                    "input_terminal": "in",
                    "input_channel": {{ channel }}
                },
                {% endfor %}

                {
                    "source_block": "infile",
                    "output_terminal": "out",
                    "output_channel": 2,
                    "destination_block": "ducker",
                    "input_terminal": "sidechain_in",
                    "input_channel": 1
                }
            ]
        }
    ],
    "parameter_settings": [
        {
            "target": "ducker",
            "name": "threshold",
            "value": 0.1
        },
        {
            "target": "ducker",
            "name": "range",
            "value": 0.1
        },
        {
            "target": "ducker",
            "name": "attack",
            "value": 0.5
        },
        {
            "target": "ducker",
            "name": "decay",
            "value": 500.0
        },
        {
            "target": "ducker",
            "name": "hold",
            "value": 1000.0
        }
    ]
}
