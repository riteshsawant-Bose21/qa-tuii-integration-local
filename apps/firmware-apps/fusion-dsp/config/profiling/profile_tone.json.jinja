{
    "session": {
        "property_settings": [
            { "name": "frame_size", "value": 32},
            { "name": "sample_rate", "value": 48000 }
        ]
    },
    "audio_tasks": [
        {
            "name": "task1",
            "property_settings": [
                { "name": "is_jack_client", "value": false },
                { "name": "frame_size", "value": 32},
                { "name": "sample_rate", "value": 48000 },
                { "name": "timing_log_file", "value": "{{ output_file }}"},
                { "name": "profile_blocks", "value": true}
            ],
            "blocks": [
                {
                    "name": "infile",
                    "algorithm": "wav_read",
                    "property_settings": [
                        { "name": "frame_size", "value": 32},
                        { "name": "sample_rate", "value": 48000 },
                        { "name": "filename", "value": "{{ wav_input }}"}
                    ],
                    "terminal_channels": [
                        { "name": "out", "channels": 1 }
                    ]
                },
                {
                    "name": "tone",
                    "algorithm": "tone_control",
                    "property_settings": [
                        { "name": "channels", "value": {{ channels }} },
                        { "name": "frame_size", "value": 32 },
                        { "name": "sample_rate", "value": 48000 }
                    ]
                },
                {
                    "name": "outfile",
                    "algorithm": "wav_write",
                    "property_settings": [
                        { "name": "frame_size", "value": 32 },
                        { "name": "sample_rate", "value": 48000 }
                    ],
                    "terminal_channels": [
                        { "name": "in", "channels": {{ channels }} }
                    ]
                }
            ],

            
            "block_connections": [
                {% for channel in range(1, channels+1) %}
                {
                    "source_block": "infile",
                    "output_terminal": "out",
                    "output_channel": 1,
                    "destination_block": "tone",
                    "input_terminal": "in",
                    "input_channel": {{ channel }}
                },
                {
                    "source_block": "tone",
                    "output_terminal": "out",
                    "output_channel": {{ channel }},
                    "destination_block": "outfile",
                    "input_terminal": "in",
                    "input_channel": {{ channel }}
                }{{ ",\n" if not loop.last else ""}}
                {% endfor %}
            ]
        }
    ],
    "parameter_settings": [
        {
            "target": "tone",
            "name": "low_gain",
            "value": 6.0
        },
        {
            "target": "tone",
            "name": "mid_gain",
            "value": 3.0
        },
        {
            "target": "tone",
            "name": "high_gain",
            "value": -6.0
        }
    ]
}
