{
    "session": {
        "property_settings": [
            { "name": "frame_size", "value": 32},
            { "name": "sample_rate", "value": 48000 }
        ]
    },
    "audio_tasks": [
        {
            "name": "task1",
            "property_settings": [
                { "name": "is_jack_client", "value": false },
                { "name": "frame_size", "value": 32},
                { "name": "sample_rate", "value": 48000 },
                { "name": "timing_log_file", "value": "{{ output_file }}"},
                { "name": "profile_blocks", "value": true}
            ],
            "blocks": [
                {
                    "name": "signal_generator",
                    "algorithm": "signal_generator",
                    "property_settings": [
                        { "name": "frame_size", "value": 32},
                        { "name": "sample_rate", "value": 48000 }
                    ],
                    "terminal_channels": [
                        { "name": "out", "channels": {{ channels }} }
                    ]
                },
                {
                    "name": "outfile",
                    "algorithm": "wav_write",
                    "property_settings": [
                        { "name": "frame_size", "value": 32 },
                        { "name": "sample_rate", "value": 48000 }
                    ],
                    "terminal_channels": [
                        { "name": "in", "channels": {{ channels }} }
                    ]
                }
            ],
            "block_connections": [
                {% for channel in range(1,channels+1) %}
                {
                    "source_block": "signal_generator",
                    "output_terminal": "out",
                    "output_channel": 1,
                    "destination_block": "outfile",
                    "input_terminal": "in",
                    "input_channel": {{ channel }}
                }{{"," if not loop.last else ""}}
                {% endfor %}
            ]
        }
    ],
    "parameter_settings": [
        {
            "target": "signal_generator",
            "name": "signal_type",
            "value": "noise"
        },
        {
            "target": "signal_generator",
            "name": "noise_type",
            "value": "pink"
        },
    ]
}

